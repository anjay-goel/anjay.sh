---
import type { ShowcaseItem } from "@/data/showcase";

interface Props {
	items: ShowcaseItem[];
	clamp?: boolean;
}

const { items, clamp = false } = Astro.props;
---

<ul class:list={["showcase-list", { clamp }]}>
	{
		items.map((item, idx) => (
			<li style={`--i: ${idx + 1}`}>
				<a href={item.href} rel="noreferrer" target="_blank">
					<div class="head">
						<span class="name">{item.icon && <img class="name-icon" src={item.icon} alt="" width="18" height="18" />}{item.name}</span>
						<span class="stack">{item.stack}</span>
						{item.badge && <span class="badge">{item.badge}</span>}
					</div>
					<p>{item.desc}</p>
				</a>
			</li>
		))
	}
</ul>

<style>
	.showcase-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	li {
		padding: 22px 0;
		transition: border-color var(--fade-theme);
	}
	li + li {
		border-top: 1px solid var(--hairline);
	}
	li:first-child {
		padding-top: 0;
	}
	a {
		text-decoration: none;
		color: inherit;
		display: block;
	}
	.head {
		display: flex;
		align-items: baseline;
		gap: 14px;
		flex-wrap: wrap;
		margin-bottom: 6px;
	}
	.name {
		font-size: var(--title-s);
		font-weight: var(--title-weight);
		letter-spacing: var(--title-tracking-s);
		color: hsl(var(--theme-text));
		transition: color var(--fade-fast);
		overflow-wrap: anywhere;
		line-height: 1.35;
	}
	.name-icon {
		display: inline-block;
		width: 1em;
		height: 1em;
		margin-right: 0.4em;
		vertical-align: -0.12em;
	}
	a:hover .name,
	a:focus-visible .name {
		color: hsl(var(--theme-accent));
	}
	.stack {
		font-size: var(--text-meta);
		color: hsl(var(--theme-text-muted));
		font-variant-numeric: tabular-nums;
	}
	.badge {
		font-size: var(--text-meta);
		color: hsl(var(--theme-text-muted));
		border: 1px solid var(--hairline);
		padding: 1px 8px;
		border-radius: 2px;
		margin-left: auto;
	}
	p {
		font-size: var(--text-sub);
		color: hsl(var(--theme-text-muted));
		margin: 6px 0 0;
		line-height: 1.55;
		overflow-wrap: anywhere;
	}
	.clamp p {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		line-clamp: 3;
		overflow: hidden;
	}
	a:focus-visible {
		outline-offset: 4px;
		border-radius: var(--radius-m);
	}
	@media (prefers-reduced-motion: no-preference) {
		a {
			transition-property: color, background-color, border-color, transform, opacity;
			transition-duration: 0.18s;
			transition-timing-function: ease;
		}
		a:active {
			transform: scale(0.992);
			opacity: 0.85;
		}
	}
	@media (max-width: 720px) {
		.head {
			display: grid;
			grid-template-columns: minmax(0, 1fr) auto;
			gap: 2px 14px;
		}
		.stack {
			grid-column: 1 / -1;
			grid-row: 2;
		}
		.badge {
			grid-column: 2;
			grid-row: 1;
		}
	}
</style>
