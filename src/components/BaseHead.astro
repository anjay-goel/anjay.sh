---
import {siteConfig} from "@/site-config";
import type {SiteMeta} from "@/types";
import {absoluteUrl, withBase} from "@/utils/path";
import "../styles/global.css";
import plexSans400 from "@/assets/fonts/ibm-plex-sans-400.woff2?url";
import plexSans600 from "@/assets/fonts/ibm-plex-sans-600.woff2?url";
import sourceSerif400 from "@/assets/fonts/source-serif-4-400.woff2?url";

type Props = SiteMeta;

const {articleDate, articleModified, description, noindex, ogImage, title} = Astro.props;

const titleSeparator = "|";
const siteTitle = `${title} ${titleSeparator} ${siteConfig.title}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = absoluteUrl(ogImage ? ogImage : "/social-card.png", Astro.site);

const analytics = siteConfig.analytics;
const gaId = analytics?.googleAnalyticsId;
const goatcounter = analytics?.goatcounterUrl;
---

<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>{siteTitle}</title>

<link rel="icon" href={withBase("/favicon-32x32.png")} sizes="32x32" type="image/png"/>
<link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml"/>
<link rel="apple-touch-icon" href={withBase("/icons/apple-touch-icon.png")}/>
{import.meta.env.PROD && <link rel="sitemap" href={withBase("/sitemap-index.xml")}/>}

<link href={withBase("/manifest.webmanifest")} rel="manifest"/>

{noindex ? <meta content="noindex" name="robots"/> : <link href={canonicalURL} rel="canonical"/>}

<meta content={siteTitle} name="title"/>
<meta content={description} name="description"/>
<meta content={siteConfig.author} name="author"/>

<link rel="preload" as="font" type="font/woff2" href={plexSans400} crossorigin />
<link rel="preload" as="font" type="font/woff2" href={plexSans600} crossorigin />
<link rel="preload" as="font" type="font/woff2" href={sourceSerif400} crossorigin />

<meta content={articleDate ? "article" : "website"} property="og:type"/>
<meta content={title} property="og:title"/>
<meta content={description} property="og:description"/>
<meta content={canonicalURL} property="og:url"/>
<meta content={siteConfig.title} property="og:site_name"/>
<meta content={siteConfig.ogLocale} property="og:locale"/>
<meta content={socialImageURL} property="og:image"/>
<meta content="1200" property="og:image:width"/>
<meta content="630" property="og:image:height"/>
{
    articleDate && (
    <>
        <meta content={siteConfig.author} property="article:author"/>
        <meta content={articleDate} property="article:published_time"/>
        {articleModified && <meta content={articleModified} property="article:modified_time"/>}
    </>
        )
    }

<meta content="summary_large_image" name="twitter:card"/>
<meta content={canonicalURL} name="twitter:url"/>
<meta content={title} name="twitter:title"/>
<meta content={description} name="twitter:description"/>
<meta content={socialImageURL} name="twitter:image"/>

<link href={withBase("/rss.xml")} rel="alternate" title={siteConfig.title} type="application/rss+xml"/>

{
    siteConfig.webmentions && (
    <>
        <link href={siteConfig.webmentions.link} rel="webmention"/>
        {siteConfig.webmentions.pingback && (
                <link href={siteConfig.webmentions.pingback} rel="pingback"/>
        )}
    </>
        )
    }

<meta content={Astro.generator} name="generator"/>

{gaId && (
    <script is:inline define:vars={{ gaId }}>
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
            window.dataLayer.push(arguments);
        };
        window.gtag("js", new Date());
        window.gtag("config", gaId);
        const events = ["pointerdown", "keydown", "scroll", "touchstart"];
        const load = () => {
            for (const name of events) removeEventListener(name, load);
            const script = document.createElement("script");
            script.async = true;
            script.src = `https://www.googletagmanager.com/gtag/js?id=${gaId}`;
            document.head.append(script);
        };
        for (const name of events) addEventListener(name, load, { once: true, passive: true });
    </script>
)}
{goatcounter && (
    <script is:inline data-goatcounter={goatcounter}
            async src="https://gc.zgo.at/count.js"></script>
)}

