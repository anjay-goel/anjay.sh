---
import type { CollectionEntry } from "astro:content";
import ExternalIcon from "@/components/blog/ExternalIcon.astro";
import { getPostHref, getPostSortDate } from "@/data/post";
import { formatRailDate, formatRailDay, formatRailYear } from "@/utils/date";

interface Props {
	posts: CollectionEntry<"post">[];
	/** Seeds the `--i` stagger-animation index (e.g. when rows follow a featured post). */
	startIndex?: number;
	/** Heading tag for each post title. */
	headingLevel?: "h2" | "h3";
	groupByYear?: boolean;
}

const { posts, startIndex = 0, headingLevel = "h2", groupByYear = false } = Astro.props;
const Heading = headingLevel;
const formatDate = groupByYear ? formatRailDay : formatRailDate;
const rows = posts.map((post) => {
	const date = getPostSortDate(post);
	return { post, date, year: formatRailYear(date) };
});
const startsYear = (idx: number) => groupByYear && rows[idx]?.year !== rows[idx - 1]?.year;
---

{
	rows.map(({ post, date, year }, idx) => (
		<>
			{startsYear(idx) && <h2 class="timeline-year">{year}</h2>}
			<a
				class="post"
				data-astro-prefetch
				href={getPostHref(post)}
				style={`--i: ${startIndex + idx}`}
			>
				<div class="post-rail">
					<time class="post-date" datetime={date.toISOString()}>
						{formatDate(date)}
					</time>
					<span class="post-dot" aria-hidden="true" />
				</div>
				<div class="post-body">
					<Heading class="post-title">
						{post.data.title}
						{post.data.externalUrl && <ExternalIcon />}
					</Heading>
					<p class="post-preview">{post.data.description}</p>
				</div>
			</a>
		</>
	))
}
