---
import { frameoArt, frameoViewBox } from "./frameo-art";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<svg
	class:list={["frameo-art", className]}
	viewBox={frameoViewBox}
	preserveAspectRatio="xMidYMid meet"
	fill="none"
	width="100%"
	height="100%"
	aria-hidden="true"
	focusable="false"
	set:html={frameoArt}
/>

<style>
	.frameo-art {
		display: block;
		width: 100%;
		height: 100%;
	}
</style>
