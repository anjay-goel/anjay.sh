---
import { type CoverKey, coverArt } from "./cover-art";

interface Props {
	name: CoverKey;
}

const { name } = Astro.props;
const art = coverArt[name];
---

<svg
	class="cover-art"
	viewBox={art.viewBox}
	preserveAspectRatio="xMidYMid meet"
	fill="none"
	width="100%"
	height="100%"
	aria-hidden="true"
	focusable="false"
	set:html={art.body}
/>

<style>
	.cover-art {
		display: block;
		width: 100%;
		height: 100%;
	}
	.cover-art :global(text[font-family="monospace"]) {
		font-family: var(--font-mono);
	}
	.cover-art :global(text[font-family="sans-serif"]) {
		font-family: var(--font-sans);
	}
</style>
