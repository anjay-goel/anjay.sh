---
import { Image } from "astro:assets";

interface Props {
	src: ImageMetadata;
	height: number;
}

const { src, height } = Astro.props;
---

<Image
	class="cover-art"
	src={src}
	alt=""
	height={height}
	densities={[1, 2, 3]}
	format="webp"
	loading="lazy"
	decoding="async"
/>

<style>
	.cover-art {
		display: block;
		max-width: 100%;
		height: auto;
		mix-blend-mode: multiply;
	}
	:global([data-theme="dark"]) .cover-art {
		filter: invert(1) hue-rotate(180deg);
		mix-blend-mode: screen;
	}
</style>
