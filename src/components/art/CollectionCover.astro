---
import { Image } from "astro:assets";

interface Props {
	src: ImageMetadata;
}

const { src } = Astro.props;
---

<Image
	class="cover-art"
	src={src}
	alt=""
	width={286}
	height={110}
	densities={[1, 2]}
	format="webp"
	loading="lazy"
	decoding="async"
/>

<style>
	.cover-art {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		mix-blend-mode: multiply;
	}
	:global([data-theme="dark"]) .cover-art {
		filter: invert(1) hue-rotate(180deg);
		mix-blend-mode: screen;
	}
</style>
