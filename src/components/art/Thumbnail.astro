---
import { type ThumbnailKey, thumbnailArt, thumbnailViewBox } from "./thumbnail-art";

interface Props {
	name: ThumbnailKey;
	part?: string;
}

const { name, part = "" } = Astro.props;
const escapeXml = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const body = thumbnailArt[name].replaceAll("__PART__", escapeXml(part));
---

<svg
	class="thumbnail-art"
	viewBox={thumbnailViewBox}
	preserveAspectRatio="xMidYMid meet"
	fill="none"
	width="100%"
	height="100%"
	aria-hidden="true"
	focusable="false"
	set:html={body}
/>

<style>
	.thumbnail-art {
		display: block;
		width: 100%;
		height: 100%;
	}
</style>
