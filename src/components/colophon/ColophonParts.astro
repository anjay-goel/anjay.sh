---
import Kbd from "@/components/ui/Kbd.astro";
import type { ColophonPart } from "@/content/copy/colophon";

interface Props {
	parts: ColophonPart[];
}

const { parts } = Astro.props;
---

{
	parts.map((part) =>
		typeof part === "string" ? (
			part
		) : part.kind === "kbd" ? (
			<Kbd>{part.text}</Kbd>
		) : part.kind === "font" ? (
			<span class:list={["specimen", `specimen-${part.font}`]}>{part.text}</span>
		) : part.kind === "link" ? (
			<a class="link colophon-link" href={part.href}>
				{part.text}
			</a>
		) : part.kind === "swatches" ? (
			<ul class="swatches">
				{part.items.map((s) => (
					<li class="swatch">
						<span class="swatch-dot" style={`background:${s.hex}`} />
						<span class="swatch-name">{`${s.name} ${s.hex}`}</span>
					</li>
				))}
			</ul>
		) : (
			<span class="desktop-only">
				<Astro.self parts={part.parts} />
			</span>
		),
	)
}

<style>
	.specimen {
		color: var(--ink);
	}
	.specimen-sans {
		font-family: var(--font-sans);
	}
	.specimen-serif {
		font-family: var(--font-serif);
	}
	.specimen-mono {
		font-family: var(--font-mono);
		font-size: var(--text-16);
	}
	.colophon-link {
		text-underline-offset: 3px;
	}
	.swatches {
		display: flex;
		flex-wrap: wrap;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.swatch {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin: 4px 18px 4px 0;
	}
	.swatch-dot {
		flex: none;
		width: 18px;
		height: 18px;
		border-radius: 50%;
		box-shadow: inset 0 0 0 1px var(--rule-strong);
	}
	.swatch-name {
		font-family: var(--font-mono);
		font-size: var(--text-14);
		color: var(--muted);
	}
	@media (max-width: 767px) {
		.desktop-only {
			display: none;
		}
	}
</style>
