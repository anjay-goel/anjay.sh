---
import { type Palette, palette } from "@/data/palette";

interface Props {
	theme: keyof typeof palette;
	color: keyof Palette;
}

const { theme, color } = Astro.props;
const hex = palette[theme][color];
---

<li class="swatch">
	<span class="swatch-dot" style={`background:${hex}`}></span>
	<span class="swatch-name"><slot /> {hex}</span>
</li>

<style>
	.swatch {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0.25rem 1.125rem 0.25rem 0;
	}
	.swatch-dot {
		flex: none;
		width: 1.125rem;
		height: 1.125rem;
		border-radius: 50%;
		box-shadow: inset 0 0 0 1px var(--rule-strong);
	}
	.swatch-name {
		font-family: var(--font-mono);
		font-size: var(--text-14);
		color: var(--muted);
	}
</style>
