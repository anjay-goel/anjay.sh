---
import Icon from "@/components/ui/Icon.astro";
import { headerCopy } from "@/content/copy/header";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
const { theme } = headerCopy;
---

<button
	class:list={["icon-btn", "theme-toggle", className]}
	type="button"
	aria-label={theme.label}
	data-theme-toggle
	data-label-to-dark={theme.toDark}
	data-label-to-light={theme.toLight}
>
	<Icon name="moon" size={18} strokeWidth={1.6} class="theme-icon-moon" />
	<Icon name="sun" size={18} strokeWidth={1.6} class="theme-icon-sun" />
</button>

<style>
	.theme-toggle {
		flex: none;
	}
	.theme-toggle :global(.theme-icon-sun) {
		display: none;
	}
	:global(:root[data-theme="dark"]) .theme-toggle :global(.theme-icon-sun) {
		display: block;
	}
	:global(:root[data-theme="dark"]) .theme-toggle :global(.theme-icon-moon) {
		display: none;
	}
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme])) .theme-toggle :global(.theme-icon-sun) {
			display: block;
		}
		:global(:root:not([data-theme])) .theme-toggle :global(.theme-icon-moon) {
			display: none;
		}
	}
</style>
