---
import ThemeToggle from "@/components/ThemeToggle.astro";
import Logo from "@/components/ui/Logo.astro";
import { headerCopy } from "@/content/copy/header";
import { withBase } from "@/utils/path";

interface Props {
	current?: string | null;
	dense?: boolean;
}

const { current, dense = false } = Astro.props;
const { nav, search } = headerCopy;
const pathname = Astro.url.pathname;

const isCurrent = (item: (typeof nav.items)[number]) => {
	if (current !== undefined) return current === item.path;
	return item.match.some((m) => {
		const target = withBase(m);
		return m === "/" ? pathname === target : pathname.startsWith(target);
	});
};

const items = nav.items.map((item) => ({ ...item, href: withBase(item.path), current: isCurrent(item) }));

const searchIcon =
	'<circle cx="10" cy="10" r="7"></circle><path d="M21 21l-6 -6"></path>';
---

<header class:list={["site-header", dense && "site-header-dense"]}>
	<div class="site-header-bar">
		<Logo />
		<div class="site-header-right">
			<nav class="site-nav site-nav-desktop" aria-label={nav.label}>
				{
					items.map((item) => (
						<a class="site-nav-link" href={item.href} aria-current={item.current ? "page" : undefined} data-label={item.title} data-astro-prefetch>
							{item.title}
						</a>
					))
				}
			</nav>
			<div class="site-header-actions">
				<button class="search-btn" type="button" data-search-open>
					<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={searchIcon} />
					<span>{search.button}</span>
				</button>
				<button class="search-icon-btn" type="button" aria-label={search.label} data-search-open>
					<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={searchIcon} />
				</button>
				<ThemeToggle />
			</div>
		</div>
	</div>
	<nav class="site-nav site-nav-phone" aria-label={nav.label}>
		{
			items.map((item) => (
				<a class="site-nav-link" href={item.href} aria-current={item.current ? "page" : undefined} data-label={item.title}>
					{item.title}
				</a>
			))
		}
	</nav>
</header>

<style>
	.site-header-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		padding: 26px 0;
		border-bottom: 1px solid var(--rule);
	}
	.site-header-dense .site-header-bar {
		padding: 24px 0;
	}
	.site-header-right {
		display: flex;
		align-items: center;
		gap: 28px;
		min-width: 0;
	}
	.site-nav-desktop {
		display: flex;
		align-items: center;
		gap: 28px;
		font-size: var(--text-16);
	}
	.site-nav-desktop .site-nav-link {
		padding: 4px 0;
		border-bottom: 1.5px solid transparent;
		color: var(--muted);
		line-height: 1.5;
	}
	.site-nav-desktop .site-nav-link:hover,
	.site-nav-desktop .site-nav-link[aria-current="page"] {
		border-bottom-color: var(--accent);
		color: var(--accent);
		font-weight: 500;
	}
	.site-nav-link {
		position: relative;
		display: inline-flex;
		flex-direction: column;
		align-items: center;
	}
	.site-nav-link::before {
		content: "";
		position: absolute;
		inset-inline: 0;
		top: 50%;
		height: max(100%, 44px);
		transform: translateY(-50%);
	}
	.site-nav-link::after {
		content: attr(data-label);
		height: 0;
		overflow: hidden;
		visibility: hidden;
		font-weight: 500;
		pointer-events: none;
		user-select: none;
	}
	.site-nav-link:focus-visible {
		outline-offset: 4px;
		border-radius: var(--radius-sm);
	}
	.site-header-actions {
		display: flex;
		align-items: center;
		gap: 8px;
	}
	.search-btn {
		display: flex;
		align-items: center;
		gap: 10px;
		height: 44px;
		padding: 0 10px 0 14px;
		border: 1px solid var(--rule);
		border-radius: var(--radius-lg);
		background: var(--paper);
		color: var(--soft);
		font-family: var(--font-sans);
		font-size: var(--text-14);
		white-space: nowrap;
	}
	.search-btn:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.search-btn:focus-visible,
	.search-icon-btn:focus-visible {
		outline-offset: 2px;
		border-radius: var(--radius-lg);
	}
	.search-icon-btn {
		display: none;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 0;
		border-radius: var(--radius-lg);
		background: transparent;
		color: var(--muted);
	}
	.search-icon-btn:hover {
		color: var(--accent);
	}
	.site-nav-phone {
		display: none;
	}

	@media (max-width: 767px) {
		.site-header-bar {
			padding: 14px 0;
		}
		.site-header-dense .site-header-bar {
			padding: 12px 0;
		}
		.site-nav-desktop,
		.search-btn {
			display: none;
		}
		.search-icon-btn {
			display: flex;
		}
		.site-header-actions {
			gap: 4px;
		}
		.site-nav-phone {
			display: flex;
			gap: 22px;
			border-bottom: 1px solid var(--rule);
			font-size: var(--text-14);
			overflow-x: auto;
			scrollbar-width: none;
		}
		.site-nav-phone .site-nav-link {
			flex: none;
			justify-content: center;
			height: 44px;
			color: var(--muted);
		}
		.site-nav-phone .site-nav-link:hover,
		.site-nav-phone .site-nav-link[aria-current="page"] {
			box-shadow: inset 0 -2px 0 var(--accent);
			color: var(--accent);
			font-weight: 500;
		}
		.site-nav-phone .site-nav-link:focus-visible {
			outline-offset: -2px;
		}
	}
</style>
