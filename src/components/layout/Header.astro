---
import { headerCopy } from "@/content/copy/header";
import { showcase } from "@/data/showcase";
import { menuLinks } from "@/site-config";
import ThemeToggle from "../ThemeToggle.astro";

const url = new URL(Astro.request.url);
const { logo } = headerCopy;

const visibleMenuLinks = menuLinks.filter((link) => {
	if (link.path === "/showcase/" && showcase.length === 0) return false;
	return true;
});

const isActive = (path: string) =>
	path === "/" ? url.pathname === path : url.pathname.startsWith(path);
---

<header class="site-header">
	<script is:inline>
		try {
			if (sessionStorage.getItem("landed")) document.documentElement.dataset.landed = "";
			else sessionStorage.setItem("landed", "1");
		} catch {}
	</script>
	<a href="/" class="wordmark hit-area" aria-label={logo.label}>
		<span class="wordmark-prefix">{logo.prefix}</span>{logo.name}<span class="wordmark-suffix">{logo.suffix}</span><span class="wordmark-cursor" aria-hidden="true"></span>
	</a>
	<div class="header-right">
		<nav class="nav" aria-label="Primary">
			{
				visibleMenuLinks.map((link) => (
					<a
						aria-current={isActive(link.path) ? "page" : false}
						class:list={[{ active: isActive(link.path) }]}
						data-astro-prefetch
						href={link.path}
					>
						{link.title}
					</a>
				))
			}
		</nav>
		<ThemeToggle />
	</div>
</header>

<style>
	.site-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 24px;
		margin-bottom: 56px;
	}
	.wordmark {
		display: inline-flex;
		align-items: center;
		font-family: var(--font-mono);
		font-size: 16px;
		font-weight: 500;
		line-height: 1.5;
		color: hsl(var(--theme-text));
		white-space: nowrap;
		transition: color var(--fade-fast), border-color var(--fade-fast);
	}
	.wordmark-prefix {
		color: hsl(var(--theme-text-muted));
	}
	.wordmark-suffix {
		color: hsl(var(--theme-accent));
	}
	@media (prefers-reduced-motion: no-preference) {
		:global(html:not([data-landed])) .wordmark-cursor {
			animation: wordmark-blink 1s steps(1) 0.3s 3;
		}
	}
	@keyframes wordmark-blink {
		50% {
			opacity: 0;
		}
	}
	.wordmark-cursor {
		display: inline-block;
		width: 8px;
		height: 17px;
		margin-left: 5px;
		background: hsl(var(--theme-accent));
	}
	.wordmark:hover {
		color: hsl(var(--theme-accent));
	}
	.header-right {
		display: flex;
		align-items: center;
		gap: 22px;
	}
	@media (min-width: 721px) {
		.header-right > :global(.theme-toggle) {
			--optical-rise: 1.5px;
			position: relative;
			top: calc(-1 * var(--optical-rise));
		}
	}
	.nav {
		display: flex;
		align-items: baseline;
		gap: 22px;
		font-size: var(--text-small);
		font-weight: 500;
		color: hsl(var(--theme-text-muted));
	}
	.nav a {
		display: inline-block;
		position: relative;
		padding-bottom: 3px;
		transition: color var(--fade-fast);
	}
	/* Indicator overhangs the text slightly so the underline isn't abrupt. */
	.nav a::after {
		content: "";
		position: absolute;
		left: -3px;
		right: -3px;
		bottom: 0;
		height: 1px;
		background: transparent;
	}
	.nav a:hover {
		color: hsl(var(--theme-accent));
	}
	.nav a.active {
		color: hsl(var(--theme-accent));
	}
	.nav a.active::after {
		background: hsl(var(--theme-accent));
	}

	@media (max-width: 720px) {
		.site-header {
			margin-bottom: 36px;
			display: grid;
			grid-template-columns: 1fr auto;
			grid-template-areas:
				"wordmark theme"
				"nav nav";
			align-items: center;
			column-gap: 14px;
			row-gap: 14px;
		}
		.wordmark { grid-area: wordmark; justify-self: start; }
		.header-right { display: contents; }
		.nav {
			grid-area: nav;
			gap: 22px;
			flex-wrap: wrap;
			justify-content: flex-start;
		}
		.nav a {
			/* Add top tap padding; desktop rule keeps the indicator space below. */
			padding-top: 6px;
		}
		.nav a::after {
			left: 0;
			right: 0;
		}
	}

	@media (max-width: 420px) {
		.site-header {
			margin-bottom: 28px;
			row-gap: 12px;
		}
		.wordmark {
			font-size: 15px;
		}
		.wordmark-cursor {
			width: 7px;
			height: 15px;
			margin-left: 4px;
		}
		.nav {
			gap: 18px;
		}
	}
</style>
