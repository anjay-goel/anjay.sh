---
import { siteConfig } from "@/site-config";

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="left">
		<span>&copy; {year} {siteConfig.author}</span>
	</div>
	<div class="right">
		<a class="hit-area" href="/tags/">Tags</a>
		<span class="sep" aria-hidden="true">·</span>
		<a class="hit-area" href="/rss.xml">RSS</a>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--hairline);
		padding-top: 22px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 16px;
		font-size: var(--text-small);
		color: hsl(var(--theme-text-muted));
		transition: border-color var(--fade-theme);
	}
	.site-footer .left {
		display: flex;
		gap: 18px;
		align-items: center;
		flex-wrap: wrap;
	}
	.site-footer .right {
		--hit-inset: -6px -8px;
		display: flex;
		align-items: center;
		gap: 12px;
	}
	.site-footer .right .sep {
		color: var(--faint);
	}
	.site-footer a {
		color: hsl(var(--theme-text-muted));
		transition: color var(--fade-fast);
	}
	.site-footer a:hover {
		color: hsl(var(--theme-accent));
	}

	@media (max-width: 420px) {
		.site-footer {
			gap: 12px;
		}
	}
</style>
