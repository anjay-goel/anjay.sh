---
import Socials from "@/components/ui/Socials.astro";
import { footerCopy } from "@/content/copy/footer";
import { siteConfig } from "@/site-config";
import { withBase } from "@/utils/path";

interface Props {
	variant?: "standard" | "home";
}

const { variant = "standard" } = Astro.props;
const year = new Date().getFullYear();
const copyright = footerCopy.copyright(year, siteConfig.author);
const rssHref = withBase("/rss.xml");
const colophonHref = withBase("/colophon/");
const email = siteConfig.profile?.email;
const { home } = footerCopy;
---

{
	variant === "home" ? (
		<footer class="site-footer site-footer-home">
			<div class="footer-home-row">
				<p class="footer-home-line">{email ? <a class="footer-home-link" href={`mailto:${email}`}>{home.email}</a> : home.email}{home.middle}<a class="footer-home-link" href={rssHref}>{home.rss}</a>{home.end}</p>
				<div class="footer-socials-inline">
					<Socials />
				</div>
				<div class="footer-socials-boxed">
					<Socials variant="boxed" label={false} />
				</div>
			</div>
			<p class="footer-legal footer-legal-home">{copyright}{footerCopy.separator}<a class="link-quiet hit-target" href={colophonHref}>{footerCopy.colophon}</a></p>
		</footer>
	) : (
		<footer class="site-footer site-footer-standard">
			<p class="footer-legal">{copyright}<span class="footer-rss">{footerCopy.separator}<a class="link-quiet hit-target" href={rssHref}>{footerCopy.rss}</a></span>{footerCopy.separator}<a class="link-quiet hit-target" href={colophonHref}>{footerCopy.colophon}</a></p>
		</footer>
	)
}

<style>
	.site-footer {
		border-top: 1px solid var(--rule);
	}
	.footer-legal {
		margin: 0;
		font-family: var(--font-mono);
		font-size: var(--text-12);
		line-height: 1.8;
		color: var(--soft);
	}
	.footer-legal a:focus-visible {
		outline-offset: 2px;
	}
	.site-footer-standard {
		padding: 24px 0 48px;
	}
	.site-footer-home {
		padding: 56px 0 64px;
	}
	.footer-home-row {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 32px;
	}
	.footer-home-line {
		flex: 1 1 380px;
		min-width: 0;
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-18);
		line-height: 1.6;
		color: var(--muted);
	}
	.footer-home-link {
		color: var(--ink);
		text-decoration-line: underline;
		text-decoration-thickness: 1px;
		text-decoration-color: var(--rule-strong);
		text-underline-offset: 4px;
	}
	.footer-home-link:hover {
		color: var(--accent);
		text-decoration-color: var(--accent);
		text-decoration-thickness: 2px;
	}
	.footer-socials-boxed {
		display: none;
	}
	.footer-legal-home {
		margin-top: 44px;
		padding-top: 20px;
		border-top: 1px dashed var(--rule-strong);
		line-height: 1.5;
	}

	@media (max-width: 767px) {
		.site-footer-standard {
			padding: 20px 0 40px;
		}
		.footer-rss {
			display: none;
		}
		.site-footer-home {
			padding: 36px 0 48px;
		}
		.footer-home-row {
			display: block;
		}
		.footer-home-line {
			font-size: var(--text-16);
		}
		.footer-socials-inline {
			display: none;
		}
		.footer-socials-boxed {
			display: block;
			margin-top: 20px;
		}
		.footer-legal-home {
			margin-top: 28px;
			padding-top: 16px;
			line-height: 1.8;
		}
	}
</style>
