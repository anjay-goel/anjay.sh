---
import { metaCopy } from "@/content/copy/meta";
import { postsCopy } from "@/content/copy/posts";
import { tagHref } from "@/data/post";
import { withBase } from "@/utils/path";

interface Props {
	tags: string[];
	current?: string;
}

const { tags, current } = Astro.props;
---

<nav class="tag-filter" aria-label={postsCopy.filter.label} data-tag-filter data-scroll-focus>
	<a
		class="tag-filter-link"
		href={withBase("/posts/")}
		aria-current={current ? undefined : "page"}
		data-astro-prefetch
	>
		{postsCopy.filter.all}
	</a>
	{
		tags.map((tag) => (
			<>
				<span class="tag-filter-sep" aria-hidden="true">
					·
				</span>
				<a
					class="tag-filter-link"
					href={tagHref(tag)}
					aria-current={tag === current ? "page" : undefined}
					data-astro-prefetch
				>
					{metaCopy.tag(tag)}
				</a>
			</>
		))
	}
</nav>

<script>
	function markScrolled(nav: HTMLElement) {
		nav.toggleAttribute("data-scrolled", nav.scrollLeft > 0);
	}
	function setupTagFilters() {
		for (const nav of document.querySelectorAll<HTMLElement>("[data-tag-filter]")) {
			const current = nav.querySelector<HTMLElement>("[aria-current]");
			if (current) {
				const end = current.offsetLeft + current.offsetWidth;
				if (end > nav.scrollLeft + nav.clientWidth - 56) {
					nav.scrollLeft = current.offsetLeft - nav.clientWidth / 3;
				}
			}
			markScrolled(nav);
			nav.addEventListener("scroll", () => markScrolled(nav), { passive: true });
		}
	}
	setupTagFilters();
</script>

<style>
	.tag-filter {
		display: flex;
		align-items: center;
		gap: 0 0.25rem;
		margin: 1.25rem 0 0 -0.375rem;
		overflow-x: auto;
		white-space: nowrap;
		scrollbar-width: none;
		scroll-padding-inline: 3rem;
		--fade-start: 0px;
		-webkit-mask-image: linear-gradient(
			to right,
			transparent,
			#000 var(--fade-start),
			#000 calc(100% - 3rem),
			transparent
		);
		mask-image: linear-gradient(
			to right,
			transparent,
			#000 var(--fade-start),
			#000 calc(100% - 3rem),
			transparent
		);
	}
	.tag-filter[data-scrolled] {
		--fade-start: 2rem;
	}
	.tag-filter::-webkit-scrollbar {
		display: none;
	}
	.tag-filter::after {
		content: "";
		flex: 0 0 2.75rem;
	}
	.tag-filter-link {
		flex: 0 0 auto;
		display: flex;
		align-items: center;
		height: var(--tap);
		padding: 0 0.375rem;
		font-family: var(--font-mono);
		font-size: var(--text-12);
		color: var(--muted);
		text-decoration-line: underline;
		text-decoration-color: transparent;
		text-decoration-thickness: 1.5px;
		text-underline-offset: 0.3125rem;
		transition:
			color var(--dur) var(--ease),
			text-decoration-color var(--dur) var(--ease);
	}
	.tag-filter-link:hover,
	.tag-filter-link[aria-current] {
		color: var(--accent);
		font-weight: 500;
		text-decoration-color: currentColor;
	}
	.tag-filter-link:focus-visible {
		outline-offset: -0.25rem;
		border-radius: var(--radius-sm);
	}
	.tag-filter-sep {
		flex: 0 0 auto;
		color: var(--rule-strong);
		font-size: var(--text-16);
	}
	@media (max-width: 767px) {
		.tag-filter {
			gap: 0 2px;
			margin: 1rem calc(var(--gutter) * -1) 0;
			padding: 0 calc(var(--gutter) - 0.375rem);
		}
	}
</style>
