---
import ArchiveRow from "./ArchiveRow.astro";

interface Props {
	title: string;
}

const { title } = Astro.props;
const hasSummary = Astro.slots.has("default");
---

<ArchiveRow class="archive-hero">
	<h1 class="page-title archive-title">{title}</h1>
	{
		hasSummary && (
			<p class="archive-summary">
				<slot />
			</p>
		)
	}
	<slot name="filter" />
</ArchiveRow>

<style>
	.archive-hero {
		padding-top: 80px;
	}
	.archive-title {
		margin: 0;
	}
	.archive-summary {
		margin: 14px 0 0;
		font-family: var(--font-sans);
		font-size: var(--text-16);
		line-height: 1.3;
		color: var(--muted);
	}
	@media (max-width: 767px) {
		.archive-hero {
			padding-top: 40px;
		}
	}
</style>
