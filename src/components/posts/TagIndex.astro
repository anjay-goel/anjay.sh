---
import { metaCopy } from "@/content/copy/meta";
import { postsCopy } from "@/content/copy/posts";
import { tagHref } from "@/data/post";
import ArchiveRow from "./ArchiveRow.astro";

interface Props {
	tags: [string, number][];
}

const { tags } = Astro.props;
---

<ArchiveRow as="section" class="tag-index" aria-label={postsCopy.tags.listLabel}>
	<ul class="tag-index-list" role="list">
		{
			tags.map(([tag, count]) => (
				<li>
					<a class="tag-index-link" href={tagHref(tag)} data-astro-prefetch>
						<span class="tag-index-name">{metaCopy.tag(tag)}</span>
						<span class="tag-index-count" aria-hidden="true">
							{postsCopy.tags.count(count)}
						</span>
						<span class="sr-only">{postsCopy.tags.countSr(count)}</span>
					</a>
				</li>
			))
		}
	</ul>
</ArchiveRow>

<style>
	.tag-index {
		padding: 56px 0 120px;
	}
	.tag-index-list {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
		gap: 0 32px;
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--rule);
	}
	.tag-index-list li {
		border-bottom: 1px solid var(--rule);
	}
	.tag-index-link {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		min-height: 52px;
		font-family: var(--font-mono);
		color: var(--muted);
		text-decoration: none;
		transition: color var(--dur) var(--ease);
	}
	.tag-index-link:hover {
		color: var(--accent);
	}
	.tag-index-link:focus-visible {
		outline-offset: -2px;
		border-radius: var(--radius-sm);
	}
	.tag-index-name {
		font-size: var(--text-14);
		overflow-wrap: anywhere;
	}
	.tag-index-link:hover .tag-index-name {
		font-weight: 500;
	}
	.tag-index-count {
		font-size: var(--text-12);
		color: var(--soft);
		font-variant-numeric: tabular-nums;
	}
	.tag-index-link:hover .tag-index-count {
		color: var(--accent);
	}
	@media (max-width: 767px) {
		.tag-index {
			padding: 32px 0 64px;
		}
		.tag-index-list {
			grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
			gap: 0 20px;
		}
	}
</style>
