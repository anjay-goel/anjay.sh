---
import PostRow from "@/components/ui/PostRow.astro";
import { postsCopy } from "@/content/copy/posts";
import { groupByYear, type PostSummary } from "@/data/post";
import ArchiveRow from "./ArchiveRow.astro";

interface Props {
	posts: PostSummary[];
}

const { posts } = Astro.props;
const groups = groupByYear(posts);
---

<div class="year-archive">
	{
		groups.map((group) => (
			<ArchiveRow as="section" class="year-group" aria-labelledby={`year-${group.year}`}>
				<div slot="aside" class="year-head">
					<h2 class="year-title" id={`year-${group.year}`}>
						{group.year}
					</h2>
					<p class="year-count">{postsCopy.yearCount(group.items.length)}</p>
				</div>
				<ul class="year-posts" role="list">
					{group.items.map((post) => (
						<li>
							<PostRow post={post} headingLevel="h3" />
						</li>
					))}
				</ul>
			</ArchiveRow>
		))
	}
</div>

<style>
	.year-archive {
		padding-bottom: 7.5rem;
	}
	.year-group {
		padding-top: 5rem;
	}
	.year-group :global(.archive-aside) {
		align-self: stretch;
	}
	.year-head {
		position: sticky;
		top: 1.5rem;
	}
	.year-title {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-44);
		font-weight: 600;
		line-height: 1;
		letter-spacing: -0.02em;
		color: var(--soft);
	}
	.year-count {
		margin: 0.625rem 0 0;
		font-family: var(--font-mono);
		font-size: var(--text-12);
		line-height: 1.3;
		color: var(--soft);
	}
	.year-posts {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	@media (max-width: 767px) {
		.year-archive {
			padding-bottom: 4rem;
		}
		.year-group {
			padding-top: 3rem;
		}
		.year-head {
			position: static;
			display: flex;
			align-items: baseline;
			gap: 0.625rem;
			margin-bottom: 1.375rem;
		}
		.year-title {
			font-size: var(--text-26);
		}
		.year-count {
			margin: 0;
		}
		.year-posts {
			gap: 1.75rem;
		}
	}
	@media (max-width: 359px) {
		.year-posts :global(.post-row-thumb) {
			flex-basis: 4rem;
			height: 3rem;
		}
	}
</style>
