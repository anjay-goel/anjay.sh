---
import { postCopy } from "@/content/copy/post";

export interface PagerLink {
	label: string;
	title: string;
	href: string;
}

interface Props {
	previous?: PagerLink;
	next?: PagerLink;
}

const { previous, next } = Astro.props;
---

{
	(previous || next) && (
		<nav class="pager" aria-label={postCopy.pager.label} data-pagefind-ignore>
			{previous && (
				<a class="pager-card" href={previous.href} data-astro-prefetch>
					<span class="pager-label">{previous.label}</span>
					<span class="pager-title">{previous.title}</span>
				</a>
			)}
			{next && (
				<a class="pager-card pager-next" href={next.href} data-astro-prefetch>
					<span class="pager-label">{next.label}</span>
					<span class="pager-title">{next.title}</span>
				</a>
			)}
		</nav>
	)
}

<style>
	.pager {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		margin-top: 4rem;
	}
	.pager-card {
		display: block;
		min-width: 0;
		padding: 1.25rem 1.375rem;
		border: 1px solid var(--rule);
		border-radius: var(--radius-lg);
		background: var(--paper);
		color: inherit;
	}
	.pager-next {
		text-align: right;
	}
	.pager-card:only-child.pager-next {
		grid-column: 2;
	}
	.pager-card:hover {
		border-color: var(--accent);
	}
	.pager-card:hover .pager-title {
		color: var(--accent);
	}
	.pager-card:focus-visible {
		outline-offset: 2px;
		border-radius: var(--radius-lg);
	}
	.pager-label {
		line-height: normal;
		display: block;
		font-family: var(--font-mono);
		font-size: var(--text-12);
		color: var(--soft);
	}
	.pager-title {
		display: block;
		margin-top: 0.375rem;
		font-family: var(--font-serif);
		font-size: var(--text-21);
		line-height: 1.3;
		transition: color var(--dur) var(--ease);
	}
	@media (max-width: 767px) {
		.pager {
			display: flex;
			flex-direction: column;
			gap: 0.625rem;
			margin-top: 2.75rem;
		}
		.pager-card {
			padding: 1rem 1.125rem;
			border-radius: var(--radius-xl);
		}
		.pager-next {
			text-align: left;
		}
		.pager-title {
			font-size: var(--text-18);
		}
	}
</style>
