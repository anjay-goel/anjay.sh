---
import Icon from "@/components/ui/Icon.astro";
import { postCopy } from "@/content/copy/post";
import type { TocItem } from "@/utils/toc";

interface Props {
	items: TocItem[];
	copyLink?: boolean;
	class?: string;
}

const { items, copyLink = false, class: className } = Astro.props;
const { toc } = postCopy;
const flat = items.every((item) => item.children.length === 0);
---

<nav class:list={["toc", flat ? "toc-flat" : "toc-nested", className]} aria-label={toc.label}>
	<p class="toc-label">{toc.label}</p>
	<ul class="toc-list">
		{
			items.map((item) => (
				<li>
					<a class="toc-link" href={`#${item.slug}`} data-toc-link>{item.text}</a>
					{item.children.length > 0 && (
						<ul class="toc-sub">
							{item.children.map((child) => (
								<li>
									<a class="toc-link toc-sub-link" href={`#${child.slug}`} data-toc-link>{child.text}</a>
								</li>
							))}
						</ul>
					)}
				</li>
			))
		}
	</ul>
	<div class="toc-progress">
		<span class="toc-track" aria-hidden="true"><span class="toc-fill" data-progress-fill></span></span>
		<span class="toc-percent" data-progress-text>{toc.progress(0)}</span>
	</div>
	<div class="toc-actions">
		<a class="toc-action" href="#top" data-back-to-top>{toc.backToTop}</a>
		{
			copyLink && (
				<button type="button" class="toc-action" data-copy-link data-label={toc.copyLink} data-label-done={toc.copied} data-label-failed={toc.copyFailed}>
					<Icon name="link" size={14} />
					<span data-copy-label>{toc.copyLink}</span>
				</button>
			)
		}
	</div>
</nav>

<style>
	.toc-label {
		line-height: normal;
		margin: 0 0 12px;
		font-family: var(--font-mono);
		font-size: var(--text-12);
		color: var(--soft);
	}
	.toc-list,
	.toc-sub {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.toc-flat .toc-list {
		padding-left: 14px;
		border-left: 1px solid var(--rule-strong);
	}
	.toc-link {
		display: block;
		padding: 7px 0;
		font-size: var(--text-14);
		line-height: 1.4;
		color: var(--muted);
	}
	.toc-link:hover {
		color: var(--accent);
	}
	.toc-link:focus-visible {
		outline-offset: 2px;
	}
	.toc-link[aria-current="location"] {
		font-weight: 500;
		color: var(--accent);
	}
	.toc-flat .toc-link[aria-current="location"],
	.toc-sub-link[aria-current="location"] {
		margin-left: -15px;
		padding-left: 13px;
		border-left: 2px solid var(--accent);
	}
	.toc-sub {
		margin: 2px 0 6px 1px;
		padding-left: 14px;
		border-left: 1px solid var(--rule-strong);
	}
	.toc-sub-link {
		padding: 6px 0;
	}
	.toc-nested li:has(.toc-sub-link[aria-current="location"]) > .toc-link {
		font-weight: 500;
		color: var(--ink);
	}
	.toc-progress {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-top: 24px;
	}
	.toc-track {
		flex: 1;
		height: 3px;
		border-radius: 2px;
		background: var(--rule);
		overflow: hidden;
	}
	.toc-fill {
		display: block;
		width: 100%;
		height: 3px;
		border-radius: 2px;
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: left;
	}
	.toc-percent {
		line-height: normal;
		min-width: 4ch;
		text-align: right;
		font-family: var(--font-mono);
		font-size: var(--text-12);
		color: var(--soft);
		font-variant-numeric: tabular-nums;
	}
	.toc-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 16px;
		margin-top: 10px;
	}
	.toc-action {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		height: 40px;
		padding: 0;
		border: 0;
		background: transparent;
		font-family: var(--font-sans);
		font-size: var(--text-14);
		color: var(--muted);
	}
	.toc-action:hover {
		color: var(--accent);
	}
	.toc-action:focus-visible {
		outline-offset: 2px;
	}
</style>
