---
import { metaCopy } from "@/content/copy/meta";
import type { MetaPart } from "@/data/post";
import { formatDayMonth, formatDayMonthYear } from "@/utils/date";

interface Props {
	date?: Date;
	dateFormat?: "dayMonth" | "full";
	parts?: MetaPart[];
}

const { date, dateFormat = "full", parts = [] } = Astro.props;
const items = parts.map((p) => (typeof p === "string" ? { text: p, accent: false } : { text: p.text, accent: Boolean(p.accent) }));
const dateText = date ? (dateFormat === "dayMonth" ? formatDayMonth(date) : formatDayMonthYear(date)) : undefined;
---

<span class="meta post-meta">{dateText && <time datetime={date?.toISOString()}>{dateText}</time>}{items.map((item, i) => <>{(i > 0 || dateText) && metaCopy.separator}<span class:list={[item.accent && "post-meta-accent"]}>{item.text}</span></>)}</span>

<style>
	.post-meta {
		display: block;
	}
	.post-meta-accent {
		color: var(--accent);
	}
</style>
