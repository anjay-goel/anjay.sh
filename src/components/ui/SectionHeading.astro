---
interface Props {
	title: string;
	id?: string;
	as?: "h2" | "h3";
	href?: string;
	linkText?: string;
	class?: string;
}

const { title, id, as: Heading = "h2", href, linkText, class: className } = Astro.props;
const hasAction = Astro.slots.has("action") || (href && linkText);
---

<div class:list={["section-heading", className]}>
	<Heading class="section-heading-title" id={id}>{title}</Heading>
	{
		hasAction && (
			<div class="section-heading-action">
				<slot name="action">
					<a class="link link-solid section-heading-link" href={href}>{linkText}</a>
				</slot>
			</div>
		)
	}
</div>

<style>
	.section-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 18px;
		margin-bottom: 36px;
	}
	.section-heading-title {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-21);
		font-weight: 600;
		line-height: 1.3;
		color: var(--ink);
	}
	.section-heading-link {
		font-size: var(--text-16);
		font-weight: 500;
	}
	@media (max-width: 767px) {
		.section-heading {
			gap: 12px;
			margin-bottom: 20px;
		}
	}
</style>
