---
interface Props {
	title: string;
	id?: string;
	href?: string;
	linkText?: string;
	class?: string;
}

const { title, id, href, linkText, class: className } = Astro.props;
const hasAction = Boolean(href && linkText);
---

<div class:list={["section-heading", className]}>
	<h2 class="section-heading-title" id={id}>{title}</h2>
	{
		hasAction && (
			<div class="section-heading-action">
				<a class="link link-solid section-heading-link hit-target" href={href}>{linkText}</a>
			</div>
		)
	}
</div>

<style>
	.section-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.125rem;
		margin-bottom: 2.25rem;
	}
	.section-heading-title {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-21);
		font-weight: 600;
		line-height: 1.3;
		color: var(--ink);
	}
	.section-heading-link {
		font-size: var(--text-16);
		font-weight: 500;
	}
	@media (max-width: 767px) {
		.section-heading {
			gap: 0.75rem;
			margin-bottom: 1.25rem;
		}
	}
</style>
