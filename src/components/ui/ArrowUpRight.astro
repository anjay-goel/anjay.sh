---
interface Props {
	size?: number;
	class?: string;
}

const { size = 13, class: className } = Astro.props;
---

<svg
	class:list={["arrow-up-right", className]}
	aria-hidden="true"
	focusable="false"
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"><path d="M17 7l-10 10"></path><path d="M8 7h9v9"></path></svg>

<style>
	.arrow-up-right {
		flex: none;
	}
</style>
