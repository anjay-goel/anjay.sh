---
import Icon, { type IconName } from "@/components/ui/Icon.astro";
import { footerCopy } from "@/content/copy/footer";
import { siteConfig } from "@/site-config";
import { withBase } from "@/utils/path";

interface Props {
	variant?: "inline" | "boxed";
	label?: boolean;
	iconSize?: number;
	class?: string;
}

const { variant = "inline", label = true, iconSize = 22, class: className } = Astro.props;
const profile = siteConfig.profile;
const copy = footerCopy.socials;

const links = [
	profile?.github && { key: "github", href: profile.github, label: copy.github, external: true },
	profile?.linkedin && { key: "linkedin", href: profile.linkedin, label: copy.linkedin, external: true },
	profile?.email && { key: "email", href: `mailto:${profile.email}`, label: copy.email, external: false },
	{ key: "rss", href: withBase("/rss.xml"), label: copy.rss, external: false },
].filter((l): l is { key: IconName; href: string; label: string; external: boolean } => Boolean(l));
---

<div class:list={["socials", `socials-${variant}`, className]}>
	{label && <span class="socials-label">{copy.label}</span>}
	<ul class="socials-list" aria-label={label ? copy.label : copy.listLabel}>
		{
			links.map((l) => (
				<li>
					<a class="socials-link" href={l.href} aria-label={l.label} rel={l.external ? "me noopener" : undefined}>
						<Icon name={l.key} size={iconSize} strokeWidth={1.5} />
					</a>
				</li>
			))
		}
	</ul>
</div>

<style>
	.socials {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		font-family: var(--font-sans);
		font-size: var(--text-18);
		color: var(--muted);
	}
	.socials-label {
		margin-right: 0.75rem;
	}
	.socials-list {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.socials-link {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		color: var(--muted);
	}
	.socials-link:hover {
		color: var(--accent);
	}
	.socials-link:focus-visible {
		outline-offset: 0;
		border-radius: var(--radius-md);
	}
	.socials-boxed .socials-list {
		gap: 0.5rem;
	}
	.socials-boxed .socials-link {
		width: 3rem;
		height: 3rem;
		border: 1px solid var(--rule);
		border-radius: var(--radius-xl);
	}
	.socials-boxed .socials-link:hover {
		border-color: var(--accent);
	}
	.socials-boxed .socials-link:focus-visible {
		outline-offset: 2px;
		border-radius: var(--radius-xl);
	}
	@media (max-width: 767px) {
		.socials-label {
			margin-right: 0.375rem;
		}
		.socials-inline .socials-list {
			gap: 0;
		}
	}
</style>
