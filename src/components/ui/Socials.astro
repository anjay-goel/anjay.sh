---
import { footerCopy } from "@/content/copy/footer";
import { siteConfig } from "@/site-config";
import { withBase } from "@/utils/path";

interface Props {
	variant?: "inline" | "boxed";
	label?: boolean;
	iconSize?: number;
	class?: string;
}

const { variant = "inline", label = true, iconSize = 22, class: className } = Astro.props;
const profile = siteConfig.profile;
const copy = footerCopy.socials;

const icons = {
	github:
		'<path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"></path>',
	linkedin:
		'<path d="M4 6a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z"></path><path d="M8 11v5"></path><path d="M8 8v.01"></path><path d="M12 16v-5"></path><path d="M16 16v-3a2 2 0 0 0 -4 0"></path>',
	email: '<rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6l9 -6"></path>',
	rss: '<path d="M5 19m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"></path><path d="M4 4a16 16 0 0 1 16 16"></path><path d="M4 11a9 9 0 0 1 9 9"></path>',
};

const links = [
	profile?.github && { key: "github", href: profile.github, label: copy.github, external: true },
	profile?.linkedin && { key: "linkedin", href: profile.linkedin, label: copy.linkedin, external: true },
	profile?.email && { key: "email", href: `mailto:${profile.email}`, label: copy.email, external: false },
	{ key: "rss", href: withBase("/rss.xml"), label: copy.rss, external: false },
].filter((l): l is { key: keyof typeof icons; href: string; label: string; external: boolean } => Boolean(l));
---

<div class:list={["socials", `socials-${variant}`, className]}>
	{label && <span class="socials-label">{copy.label}</span>}
	<ul class="socials-list" aria-label={label ? copy.label : copy.listLabel}>
		{
			links.map((l) => (
				<li>
					<a class="socials-link" href={l.href} aria-label={l.label} rel={l.external ? "me noopener" : undefined}>
						<svg
							aria-hidden="true"
							width={iconSize}
							height={iconSize}
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"
							set:html={icons[l.key]}
						/>
					</a>
				</li>
			))
		}
	</ul>
</div>

<style>
	.socials {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		font-family: var(--font-sans);
		font-size: var(--text-18);
		color: var(--muted);
	}
	.socials-label {
		margin-right: 8px;
	}
	.socials-list {
		display: flex;
		align-items: center;
		gap: 4px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.socials-link {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		color: var(--muted);
	}
	.socials-link:hover {
		color: var(--accent);
	}
	.socials-link:focus-visible {
		outline-offset: 0;
		border-radius: var(--radius-md);
	}
	.socials-boxed .socials-list {
		gap: 8px;
	}
	.socials-boxed .socials-link {
		width: 48px;
		height: 48px;
		border: 1px solid var(--rule);
		border-radius: var(--radius-xl);
	}
	.socials-boxed .socials-link:hover {
		border-color: var(--accent);
	}
	.socials-boxed .socials-link:focus-visible {
		outline-offset: 2px;
		border-radius: var(--radius-xl);
	}
	@media (max-width: 767px) {
		.socials-label {
			margin-right: 6px;
		}
		.socials-inline .socials-list {
			gap: 0;
		}
	}
</style>
