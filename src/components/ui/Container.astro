---
import type { HTMLTag, Polymorphic } from "astro/types";

type Props<Tag extends HTMLTag = "div"> = Polymorphic<{ as: Tag }> & {
	width?: "default" | "article";
};

const { as: Tag = "div", width = "default", class: className, ...rest } = Astro.props;
---

<Tag class:list={["container", width === "article" && "container-article", className]} {...rest}>
	<slot />
</Tag>

<style>
	.container {
		box-sizing: border-box;
		width: 100%;
		max-width: calc(var(--page-max) + 2 * var(--gutter));
		margin-inline: auto;
		padding-inline: max(var(--gutter), env(safe-area-inset-left)) max(var(--gutter), env(safe-area-inset-right));
	}
	.container-article {
		max-width: calc(var(--page-max-article) + 2 * var(--gutter));
	}
</style>
