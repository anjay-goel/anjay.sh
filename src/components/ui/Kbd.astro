---
interface Props {
	size?: "sm" | "md";
}

const { size = "md" } = Astro.props;
---

<kbd class:list={["kbd", `kbd-${size}`]}><slot /></kbd>

<style>
	.kbd {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		box-sizing: border-box;
		border: 1px solid var(--rule-strong);
		border-bottom-width: 2px;
		background: var(--paper);
		font-family: var(--font-mono);
		font-weight: 400;
		line-height: 1;
		color: var(--ink);
		white-space: nowrap;
	}
	.kbd-md {
		min-width: 1.625rem;
		height: 1.625rem;
		padding: 0 0.4375rem;
		border-radius: var(--radius-sm);
		font-size: var(--text-14);
	}
	.kbd-sm {
		min-width: 1.375rem;
		height: 1.375rem;
		padding: 0 0.375rem;
		border-radius: 0.3125rem;
		font-size: var(--text-12);
	}
</style>
