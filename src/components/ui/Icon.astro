---
const paths = {
	arrowLeft: ["M20 12H4", "M10 6l-6 6l6 6"],
	arrowUpRight: ["M17 7l-10 10", "M8 7h9v9"],
	check: ["M5 12l5 5l10 -10"],
	chevronDown: ["M6 9l6 6l6 -6"],
	chevronLeft: ["M15 6l-6 6l6 6"],
	chevronRight: ["M9 6l6 6l-6 6"],
	email: [
		"M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z",
		"M3 7l9 6l9 -6",
	],
	github: [
		"M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5",
	],
	link: [
		"M9 15l6 -6",
		"M11 6l.463 -.536a5 5 0 0 1 7.071 7.072l-.534 .464",
		"M13 18l-.397 .534a5.068 5.068 0 0 1 -7.127 0a4.972 4.972 0 0 1 0 -7.071l.524 -.463",
	],
	linkedin: [
		"M4 6a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z",
		"M8 11v5",
		"M8 8v.01",
		"M12 16v-5",
		"M16 16v-3a2 2 0 0 0 -4 0",
	],
	moon: ["M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454z"],
	rss: [
		"M4 19a1 1 0 1 0 2 0a1 1 0 1 0 -2 0",
		"M4 4a16 16 0 0 1 16 16",
		"M4 11a9 9 0 0 1 9 9",
	],
	search: ["M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0", "M21 21l-6 -6"],
	sun: [
		"M8 12a4 4 0 1 0 8 0a4 4 0 1 0 -8 0",
		"M3 12h1m8 -9v1m8 8h1m-9 8v1m-6.4 -15.4l.7 .7m12.1 -.7l-.7 .7m0 11.4l.7 .7m-12.1 -.7l-.7 .7",
	],
} as const;

export type IconName = keyof typeof paths;

interface Props {
	name: IconName;
	size?: number | string;
	strokeWidth?: number;
	class?: string;
}

const { name, size = 16, strokeWidth = 1.75, class: className } = Astro.props;
const length = typeof size === "number" ? `${size / 16}rem` : size;
---

<svg
	class:list={["icon", className]}
	aria-hidden="true"
	focusable="false"
	width={length}
	height={length}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width={strokeWidth}
	stroke-linecap="round"
	stroke-linejoin="round">{paths[name].map((d) => <path d={d} />)}</svg>

<style>
	.icon {
		flex: none;
	}
</style>
