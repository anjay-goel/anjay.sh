---
import CollectionCover from "@/components/art/CollectionCover.astro";
import { type CollectionDoc, collectionCountLabel } from "@/data/collections";

interface Props {
	collection: CollectionDoc;
}

const { collection } = Astro.props;
const { title, description, cover } = collection.data;
---

<section class="collection-hero" aria-labelledby="collection-title">
	<div class="collection-hero-cover">
		<CollectionCover name={cover} />
	</div>
	<div class="collection-hero-text">
		<h1 class="collection-hero-title" id="collection-title">{title}</h1>
		<p class="collection-hero-count">{collectionCountLabel(collection)}</p>
		<p class="collection-hero-desc reading">{description}</p>
	</div>
</section>

<style>
	.collection-hero {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 48px;
		padding: 32px 0 72px;
	}
	.collection-hero-cover {
		flex: 1 1 420px;
		min-width: 0;
		height: 280px;
		border: 1px solid var(--rule);
		border-radius: var(--radius-xl);
		background: var(--panel);
		overflow: hidden;
	}
	.collection-hero-text {
		flex: 1 1 440px;
		min-width: 0;
	}
	.collection-hero-title {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-64);
		font-weight: 600;
		line-height: 1.02;
		letter-spacing: -0.028em;
		color: var(--ink);
		text-wrap: balance;
	}
	.collection-hero-count {
		margin: 10px 0 0;
		font-family: var(--font-sans);
		font-size: var(--text-14);
		line-height: 1.3;
		color: var(--soft);
	}
	.collection-hero-desc {
		max-width: 30em;
		margin: 18px 0 0;
		font-size: var(--text-21);
		line-height: 1.6;
		color: var(--muted);
	}
	@media (max-width: 767px) {
		.collection-hero {
			display: block;
			padding: 4px 0 0;
		}
		.collection-hero-cover {
			height: 180px;
			border-radius: var(--radius-lg);
		}
		.collection-hero-title {
			margin-top: 22px;
			font-size: var(--text-34);
			line-height: 1.05;
			letter-spacing: -0.026em;
		}
		.collection-hero-desc {
			margin-top: 12px;
			font-size: var(--text-18);
			line-height: 1.55;
		}
	}
</style>
