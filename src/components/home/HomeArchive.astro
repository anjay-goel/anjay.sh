---
import { homeCopy } from "@/content/copy/home";
import { withBase } from "@/utils/path";

interface Props {
	years: number[];
}

const { years } = Astro.props;
const copy = homeCopy.archive;
---

<section class="archive" aria-labelledby="archive-h">
	<div class="archive-row">
		<h2 id="archive-h" class="archive-title">{copy.title}</h2>
		<nav class="archive-years" aria-label={copy.navLabel}>
			{
				years.map((year, i) => (
					<>
						{i > 0 && <span class="archive-dot" aria-hidden="true">·</span>}
						<a class="archive-year" href={withBase(`/posts/#year-${year}`)} aria-label={copy.yearLabel(year)}>{year}</a>
					</>
				))
			}
		</nav>
	</div>
</section>

<style>
	.archive {
		padding-bottom: 7rem;
	}
	.archive-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 0.5rem;
		padding: 1rem 0;
		border-top: 1px solid var(--rule);
		border-bottom: 1px solid var(--rule);
	}
	.archive-title {
		margin: 0;
		font-size: var(--text-16);
		font-weight: 500;
		line-height: 1.5;
		color: var(--soft);
	}
	.archive-years {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 2px;
	}
	.archive-year {
		display: flex;
		align-items: center;
		height: var(--tap);
		padding: 0 0.5rem;
		font-family: var(--font-mono);
		font-size: var(--text-16);
		color: var(--ink);
		text-decoration-line: underline;
		text-decoration-thickness: 1px;
		text-decoration-color: var(--rule-strong);
		text-underline-offset: 0.25rem;
	}
	.archive-year:hover {
		color: var(--accent);
		text-decoration-color: var(--accent);
	}
	.archive-year:focus-visible {
		outline-offset: 0;
		border-radius: var(--radius-sm);
	}
	.archive-dot {
		color: var(--rule-strong);
	}
	@media (max-width: 767px) {
		.archive {
			padding-bottom: 3.5rem;
		}
		.archive-row {
			display: block;
			padding: 0;
			border: 0;
		}
		.archive-title {
			margin-bottom: 0.375rem;
			font-size: var(--text-12);
			line-height: 1.3;
		}
		.archive-years {
			justify-content: space-between;
			gap: 0;
			white-space: nowrap;
			border-top: 1px solid var(--rule);
			border-bottom: 1px solid var(--rule);
		}
		.archive-year {
			padding: 0 0.25rem;
			font-size: var(--text-14);
		}
	}
	@media (max-width: 380px) {
		.archive-years {
			flex-wrap: nowrap;
		}
		.archive-dot {
			display: none;
		}
		.archive-year {
			padding: 0 2px;
		}
	}
</style>
