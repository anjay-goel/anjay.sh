---
import CollectionCover from "@/components/art/CollectionCover.astro";
import Card from "@/components/ui/Card.astro";
import { homeCopy } from "@/content/copy/home";
import { metaCopy } from "@/content/copy/meta";
import {
	type CollectionDoc,
	collectionCountLabel,
	collectionHref,
	orderCollectionPosts,
	seriesPartFor,
} from "@/data/collections";
import type { PostSummary } from "@/data/post";

interface Props {
	collections: CollectionDoc[];
	posts: PostSummary[];
}

const { collections, posts } = Astro.props;
const copy = homeCopy.collections;

const partTitle = (title: string, collection: CollectionDoc) => {
	const i = title.indexOf(": ");
	return title.startsWith(collection.data.title) && i > 0 ? title.slice(i + 2) : title;
};

const cards = collections.map((c) => {
	const series = c.data.kind === "series";
	const items = orderCollectionPosts(c, posts).map((p) => ({
		post: p,
		title: series ? partTitle(p.title, c) : p.title,
		marker: series ? seriesPartFor(c, p.id)?.roman : undefined,
		tag: series ? undefined : copy.itemTags[p.id],
	}));
	return {
		collection: c,
		series,
		href: series && items[0] ? items[0].post.href : collectionHref(c),
		count: collectionCountLabel(c),
		items,
	};
});

const arrow = { prev: "M15 6l-6 6l6 6", next: "M9 6l6 6l-6 6" };
---

<section class="collections" aria-labelledby="collections-h">
	<div class="collections-head">
		<h2 id="collections-h" class="collections-title">
			<span class="title-wide">{copy.title}</span><span class="title-short">{copy.shortTitle}</span>
		</h2>
		<div class="carousel-controls" data-carousel-controls>
			<button type="button" class="carousel-btn" aria-label={copy.previous} data-carousel-prev disabled>
				<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d={arrow.prev} /></svg>
			</button>
			<button type="button" class="carousel-btn" aria-label={copy.next} data-carousel-next>
				<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d={arrow.next} /></svg>
			</button>
		</div>
		<span class="meta swipe-hint" aria-hidden="true">{copy.swipe}</span>
	</div>

	<ul class="track track-wide" role="list" data-carousel-track>
		{
			cards.map((card) => (
				<li class="slide">
					<Card as="article" padding="lg" class="collection-card">
						<div class="card-cover" aria-hidden="true">
							<CollectionCover name={card.collection.data.cover} />
						</div>
						<h3 class="card-heading">
							<span class="card-title">{card.collection.data.title}</span> <span class="card-count">{card.count}</span>
						</h3>
						<p class="card-desc">{card.collection.data.description}</p>
						<ol class="card-items" role="list">
							{card.items.map((item) => (
								<li>
									<a class="card-item" href={item.post.href} data-astro-prefetch={item.post.external ? undefined : true}>
										{item.marker && (
											<span class="card-item-marker">
												<span class="sr-only">{metaCopy.part(item.marker)}</span>
												<span aria-hidden="true">{item.marker}</span>
											</span>
										)}
										<span class="card-item-title">{item.title}</span>
										{item.tag && <span class="card-item-tag">{item.tag}</span>}
									</a>
								</li>
							))}
						</ol>
						<a class="card-link card-cta" href={card.href} data-astro-prefetch>{card.collection.data.cta ?? card.collection.data.title}</a>
					</Card>
				</li>
			))
		}
	</ul>

	<ul class="track track-short" role="list">
		{
			cards.map((card) => (
				<li class="slide-short">
					<Card href={collectionHref(card.collection)} padding="none" class="collection-card-short" data-astro-prefetch>
						<div class="short-cover" aria-hidden="true">
							<CollectionCover name={card.collection.data.cover} detail={false} />
						</div>
						<div class="short-body">
							<p class="short-heading">
								<span class="card-title">{card.collection.data.title}</span> <span class="card-count">{card.count}</span>
							</p>
							<p class="short-desc">{card.collection.data.shortDescription ?? card.collection.data.description}</p>
						</div>
					</Card>
				</li>
			))
		}
	</ul>
</section>

<script>
	function initCarousel() {
		const track = document.querySelector<HTMLElement>("[data-carousel-track]");
		const prev = document.querySelector<HTMLButtonElement>("[data-carousel-prev]");
		const next = document.querySelector<HTMLButtonElement>("[data-carousel-next]");
		if (!track || !prev || !next) return;

		const update = () => {
			const max = track.scrollWidth - track.clientWidth;
			prev.disabled = track.scrollLeft <= 1;
			next.disabled = track.scrollLeft >= max - 1;
		};

		const step = () => {
			const slide = track.querySelector<HTMLElement>("li");
			const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
			return slide ? slide.offsetWidth + gap : track.clientWidth;
		};

		const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
		const go = (dir: number) =>
			track.scrollBy({ left: dir * step(), behavior: reduced.matches ? "auto" : "smooth" });

		prev.addEventListener("click", () => go(-1));
		next.addEventListener("click", () => go(1));

		let frame = 0;
		track.addEventListener(
			"scroll",
			() => {
				cancelAnimationFrame(frame);
				frame = requestAnimationFrame(update);
			},
			{ passive: true },
		);
		new ResizeObserver(update).observe(track);
		update();
	}

	initCarousel();
</script>

<style>
	.collections {
		padding-bottom: 112px;
	}
	.collections-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 18px;
		margin-bottom: 36px;
	}
	.collections-title {
		margin: 0;
		font-size: var(--text-21);
		font-weight: 600;
		line-height: 1.3;
	}
	.title-short,
	.swipe-hint,
	.track-short {
		display: none;
	}
	.carousel-controls {
		display: flex;
		gap: 8px;
	}
	.carousel-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 1px solid var(--rule);
		border-radius: 50%;
		background: var(--paper);
		color: var(--ink);
	}
	.carousel-btn:hover:not(:disabled) {
		border-color: var(--accent);
		color: var(--accent);
	}
	.carousel-btn:active:not(:disabled) {
		border-color: var(--accent);
		background: var(--accent);
		color: var(--paper);
	}
	.carousel-btn:disabled {
		color: var(--soft);
		cursor: default;
	}
	.carousel-btn:focus-visible {
		outline-offset: 2px;
		border-radius: 50%;
	}
	.track {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.track-wide {
		display: flex;
		gap: 24px;
		margin-right: calc((100vw - 100%) / -2);
		padding: 0 40px 8px 0;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
	}
	.track-wide::-webkit-scrollbar {
		display: none;
	}
	.slide {
		position: relative;
		display: flex;
		flex: 0 0 388px;
		scroll-snap-align: start;
	}
	.slide :global(.collection-card) {
		flex: 1;
	}
	.card-cover {
		height: 150px;
		margin: -30px -28px 24px;
		border-bottom: 1px solid var(--rule);
		background: var(--panel);
		overflow: hidden;
	}
	.card-heading {
		margin: 0 0 10px;
		font-size: var(--text-34);
		line-height: 1.1;
		letter-spacing: -0.018em;
	}
	.card-count {
		font-size: var(--text-14);
		font-weight: 400;
		letter-spacing: 0;
		color: var(--soft);
	}
	.card-desc {
		margin: 0 0 20px;
		font-size: var(--text-16);
		line-height: 1.55;
		color: var(--muted);
	}
	.card-items {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.card-item {
		display: flex;
		align-items: baseline;
		gap: 16px;
		padding: 13px 0;
		border-top: 1px dashed var(--rule-strong);
		color: inherit;
		text-decoration: none;
	}
	.card-items li:last-child .card-item {
		border-bottom: 1px dashed var(--rule-strong);
	}
	.card-item:focus-visible {
		outline-offset: 2px;
	}
	.card-item-marker {
		flex: 0 0 24px;
		margin-right: -2px;
		font-family: var(--font-mono);
		font-size: var(--text-12);
		color: var(--accent);
	}
	.card-item-title {
		flex: 1;
		min-width: 0;
		font-size: var(--text-18);
		font-weight: 500;
		line-height: 1.3;
		transition: color var(--dur) var(--ease);
	}
	.card-item:hover .card-item-title {
		color: var(--accent);
	}
	.card-item-tag {
		font-family: var(--font-mono);
		font-size: var(--text-12);
		color: var(--soft);
	}
	.card-cta {
		align-self: flex-start;
		margin-top: auto;
		padding-top: 20px;
		font-size: var(--text-14);
		color: var(--accent);
		text-decoration-line: underline;
		text-decoration-color: transparent;
		text-underline-offset: 4px;
	}
	.card-cta:hover {
		text-decoration-color: var(--accent);
	}

	@media (max-width: 767px) {
		.collections {
			padding-bottom: 56px;
		}
		.collections-head {
			align-items: baseline;
			gap: 12px;
			margin-bottom: 20px;
		}
		.title-wide,
		.carousel-controls,
		.track-wide {
			display: none;
		}
		.title-short,
		.swipe-hint {
			display: inline;
		}
		.track-short {
			display: flex;
			gap: 12px;
			margin: 0 calc(-1 * var(--gutter));
			padding: 0 var(--gutter) 4px;
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			scroll-padding-inline: var(--gutter);
			scrollbar-width: none;
		}
		.track-short::-webkit-scrollbar {
			display: none;
		}
		.slide-short {
			display: flex;
			flex: 0 0 292px;
			max-width: calc(100vw - 2 * var(--gutter) - 24px);
			scroll-snap-align: start;
		}
		.slide-short :global(.collection-card-short) {
			flex: 1;
		}
		.short-cover {
			height: 124px;
			border-bottom: 1px solid var(--rule);
			background: var(--panel);
		}
		.short-body {
			padding: 18px 18px 20px;
		}
		.short-heading {
			margin: 0 0 6px;
			font-size: var(--text-26);
			font-weight: 600;
			line-height: 1.12;
		}
		.short-desc {
			margin: 0;
			font-size: var(--text-14);
			line-height: 1.5;
			color: var(--muted);
		}
	}
</style>

<style is:global>
	:root:has([data-carousel-track]) body {
		overflow-x: clip;
	}
</style>
