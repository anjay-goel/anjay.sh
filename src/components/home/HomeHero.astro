---
import Socials from "@/components/ui/Socials.astro";
import { homeCopy } from "@/content/copy/home";
import { siteConfig } from "@/site-config";

const copy = homeCopy.hero;
---

<section class="hero">
	<div class="hero-text">
		<h1 class="page-title">{copy.title}</h1>
		<p class="hero-intro reading">{siteConfig.intro}</p>
		<Socials class="hero-socials" iconSize={23} />
	</div>
</section>

<style>
	.hero {
		padding: 3.5rem 0 4rem;
	}
	.hero .page-title {
		font-size: var(--text-44);
	}
	.hero-intro {
		max-width: 34em;
		margin: 1.25rem 0 0;
		font-size: var(--text-21);
		line-height: 1.6;
		color: var(--muted);
	}
	.hero :global(.hero-socials) {
		margin-top: 1.5rem;
	}
	@media (max-width: 899px) {
		.hero-intro {
			margin-top: 1.25rem;
			font-size: var(--text-18);
		}
	}
	@media (max-width: 767px) {
		.hero {
			padding: 3rem 0 2.5rem;
		}
		.hero .page-title {
			font-size: var(--text-34);
		}
		.hero :global(.hero-socials) {
			margin-top: 1.125rem;
		}
		.hero :global(.hero-socials svg) {
			width: 1.375rem;
			height: 1.375rem;
		}
	}
</style>
