---
import { homeCopy, type TerminalRow } from "@/content/copy/home";
import { metaCopy } from "@/content/copy/meta";
import { showcase } from "@/data/showcase";

const SHIPPED_ROWS = 3;

interface Props {
	postCount: number;
}

const { postCount } = Astro.props;
const copy = homeCopy.terminal;
const shipped = showcase
	.slice(0, SHIPPED_ROWS)
	.map((item): TerminalRow =>
		item.reach ? { key: item.name, accent: item.reach, value: metaCopy.installs } : { key: item.name, value: item.badge ?? "" },
	);
const groups: { command: string; rows: TerminalRow[]; lead?: string; result?: string }[] = [
	{ command: copy.whoami.command, lead: copy.whoami.name, rows: copy.whoami.rows },
	{ command: copy.shipped.command, rows: shipped },
	{ command: copy.posts.command, rows: [], result: String(postCount) },
];
---

<div class="terminal" role="group" aria-label={copy.label}>
	<div class="terminal-bar" aria-hidden="true"><span>{copy.title}</span><span>{copy.shell}</span></div>
	<div class="terminal-body">
		{
			groups.map((g) => (
				<div class="terminal-group">
					<p class="terminal-cmd"><span class="terminal-prompt" aria-hidden="true">{copy.prompt}</span> {g.command}</p>
					{g.lead && <p class="terminal-lead">{g.lead}</p>}
					{g.rows.length > 0 && (
						<dl class="terminal-rows">
							{g.rows.map((r) => (
								<div class="terminal-row">
									<dt>{r.key}</dt>
									<dd>{r.accent && <span class="terminal-accent">{r.accent}</span>}{r.value}</dd>
								</div>
							))}
						</dl>
					)}
					{g.result && <p class="terminal-result">{g.result}</p>}
				</div>
			))
		}
	</div>
</div>

<style>
	.terminal {
		min-width: 0;
		border: 1px solid var(--rule);
		border-radius: var(--radius-lg);
		background: var(--paper);
		overflow: hidden;
		font-family: var(--font-mono);
	}
	.terminal-bar {
		display: flex;
		justify-content: space-between;
		padding: 0.75rem 1.125rem;
		border-bottom: 1px solid var(--rule);
		font-size: var(--text-12);
		line-height: 1.3;
		color: var(--soft);
	}
	.terminal-body {
		padding: 1.25rem 1.375rem 1.5rem;
		font-size: var(--text-12);
		line-height: 1.8;
		color: var(--ink);
	}
	.terminal-body p,
	.terminal-body dl,
	.terminal-body dd {
		margin: 0;
	}
	.terminal-group + .terminal-group {
		margin-top: 0.75rem;
	}
	.terminal-prompt {
		color: var(--ok);
	}
	.terminal-lead {
		font-weight: 500;
	}
	.terminal-row {
		display: grid;
		grid-template-columns: 7.25rem minmax(0, 1fr);
	}
	.terminal-row dd,
	.terminal-result {
		color: var(--muted);
	}
	.terminal-accent {
		color: var(--accent);
	}
	@media (max-width: 767px) {
		.terminal {
			border-radius: var(--radius-xl);
		}
		.terminal-bar {
			padding: 0.625rem 0.875rem;
		}
		.terminal-body {
			padding: 0.875rem 1rem 1rem;
		}
		.terminal-group + .terminal-group {
			margin-top: 0.5rem;
		}
		.terminal-row {
			grid-template-columns: 6.25rem minmax(0, 1fr);
		}
	}
</style>
