---
import FrameoPipeline from "@/components/art/FrameoPipeline.astro";
import Icon from "@/components/ui/Icon.astro";
import { homeCopy } from "@/content/copy/home";
import { metaCopy } from "@/content/copy/meta";
import { featuredProject as featured, showcase, showcaseBadge } from "@/data/showcase";

const copy = homeCopy.shipped;

const rows = showcase.map((item) => ({
	name: item.name,
	href: item.href,
	description: item.summary,
	kind: item.stack,
	reach: showcaseBadge(item),
	reachAccent: item.highlight === true,
}));
---

<section class="shipped" aria-labelledby="shipped-h">
	<h2 id="shipped-h" class="shipped-title">
		<span class="title-wide">{copy.title}</span><span class="title-short">{copy.shortTitle}</span>
	</h2>
	<a class="spread" href={featured.href} rel="noopener">
		<div class="spread-text">
			<span class="spread-status">{copy.status}</span>
			<span class="spread-name">{featured.name}</span>
			<span class="spread-desc">{featured.desc}</span>
			<span class="spread-link">
				{featured.linkText}
				<Icon name="arrowUpRight" size={13} strokeWidth={2} />
				<span class="sr-only">{metaCopy.externalSr}</span>
			</span>
		</div>
		<div class="spread-art" aria-hidden="true">
			<FrameoPipeline />
		</div>
	</a>
	<ul class="projects" role="list" aria-label={copy.listLabel}>
		{
			rows.map((row) => (
				<li>
					<a class="project" href={row.href} rel="noopener">
						<span class="project-name">{row.name}</span>
						<span class="project-desc">{row.description}</span>
						<span class="project-kind">{row.kind}</span>
						<span class:list={["project-reach", row.reachAccent && "project-reach-accent"]}>{row.reach}</span>
						<span class="project-arrow">
							<Icon name="arrowUpRight" size={14} strokeWidth={2} />
							<span class="sr-only">{metaCopy.externalSr}</span>
						</span>
					</a>
				</li>
			))
		}
	</ul>
</section>

<style>
	.shipped {
		padding-bottom: 7.5rem;
	}
	.shipped-title {
		margin: 0 0 2.25rem;
		font-size: var(--text-26);
		font-weight: 600;
		line-height: 1.3;
	}
	.title-short {
		display: none;
	}
	.spread {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 3rem;
		color: inherit;
		text-decoration: none;
	}
	.spread:focus-visible {
		outline-offset: 0.5rem;
		border-radius: var(--radius-md);
	}
	.spread-text {
		flex: 1 1 22.5rem;
		min-width: 0;
	}
	.spread-status {
		display: block;
		font-size: var(--text-14);
		line-height: 1.3;
		color: var(--ok);
	}
	.spread-name {
		display: block;
		margin-top: 1rem;
		font-size: var(--text-display);
		font-weight: 600;
		line-height: 1;
		letter-spacing: -0.025em;
		transition: color var(--dur) var(--ease);
	}
	.spread-desc {
		display: block;
		max-width: 30em;
		margin-top: 0.875rem;
		font-size: var(--text-18);
		line-height: 1.6;
		color: var(--muted);
	}
	.spread-link {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		margin-top: 1rem;
		font-size: var(--text-14);
		line-height: 1.5;
		color: var(--accent);
	}
	.spread:hover .spread-name {
		color: var(--accent);
	}
	.spread-art {
		flex: 1 1 26.375rem;
		min-width: 0;
		height: 11.25rem;
		border: 1px solid var(--rule);
		border-radius: var(--radius-xl);
		background: var(--panel);
		overflow: hidden;
		transition: border-color var(--dur) var(--ease);
	}
	.spread:hover .spread-art {
		border-color: var(--accent);
	}
	.projects {
		margin: 4rem 0 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--rule-strong);
	}
	.projects li + li {
		border-top: 1px solid var(--rule);
	}
	.project {
		display: grid;
		grid-template-columns: 12.5rem minmax(0, 1fr) 11.875rem 7.5rem 1rem;
		align-items: baseline;
		gap: 1.75rem;
		padding: 1.375rem 0;
		color: inherit;
		text-decoration: none;
	}
	.project:focus-visible {
		outline-offset: 2px;
	}
	.project-name {
		font-size: var(--text-21);
		font-weight: 600;
		line-height: 1.3;
		letter-spacing: -0.01em;
		transition: color var(--dur) var(--ease);
	}
	.project-desc {
		font-size: var(--text-16);
		line-height: 1.5;
		color: var(--muted);
	}
	.project-kind,
	.project-reach {
		font-family: var(--font-mono);
		font-size: var(--text-12);
		line-height: 1.5;
		color: var(--soft);
	}
	.project-reach {
		text-align: right;
	}
	.project-reach-accent {
		color: var(--accent);
	}
	.project-arrow {
		color: var(--soft);
		transition: color var(--dur) var(--ease);
	}
	.project:hover .project-name,
	.project:hover .project-arrow {
		color: var(--accent);
	}

	@media (max-width: 1023px) {
		.project {
			grid-template-columns: minmax(0, 1fr) auto;
			grid-template-areas:
				"name reach"
				"desc desc"
				"kind kind";
			gap: 0 0.75rem;
			padding: 1rem 0;
		}
		.project-name {
			grid-area: name;
		}
		.project-reach {
			grid-area: reach;
			white-space: nowrap;
		}
		.project-desc {
			grid-area: desc;
			margin-top: 0.25rem;
		}
		.project-kind {
			grid-area: kind;
			margin-top: 0.375rem;
		}
		.project-arrow {
			display: none;
		}
	}

	@media (max-width: 767px) {
		.shipped {
			padding-bottom: 3.5rem;
		}
		.shipped-title {
			margin-bottom: 1.25rem;
		}
		.title-wide {
			display: none;
		}
		.title-short {
			display: inline;
		}
		.spread {
			display: flex;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
		}
		.spread-text {
			display: contents;
		}
		.spread-status {
			order: 1;
		}
		.spread-art {
			order: 2;
			flex: none;
			height: 6rem;
			margin-top: 0.875rem;
			border-radius: var(--radius-lg);
		}
		.spread-name {
			order: 3;
			margin-top: 0.875rem;
			font-size: var(--text-26);
		}
		.spread-desc {
			order: 4;
			margin-top: 0.375rem;
			font-size: var(--text-14);
			line-height: 1.45;
		}
		.spread-link {
			display: none;
		}
		.projects {
			margin-top: 2.25rem;
		}
		.project-name {
			font-size: var(--text-18);
			letter-spacing: 0;
		}
		.project-desc {
			font-size: var(--text-14);
		}
	}
</style>
