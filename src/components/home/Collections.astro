---
import { Icon } from "astro-icon/components";
import CollectionCover from "@/components/art/CollectionCover.astro";
import { collectionsCopy } from "@/content/copy/collections";
import {
	type CollectionDoc,
	collectionCountLabel,
	collectionHref,
	previewCollectionPosts,
} from "@/data/collections";
import { getAllPosts, getPostHref } from "@/data/post";

interface Props {
	collections: CollectionDoc[];
}

const { collections } = Astro.props;
const posts = await getAllPosts();

const COVER_HEIGHT = 132;
const ART_HEIGHT = 100;
const ART_WIDTH = 188;
const SLIDE_POSTS = 3;

const artHeight = (cover: ImageMetadata) =>
	Math.round(Math.min(ART_HEIGHT, (ART_WIDTH * cover.height) / cover.width));

const shortTitle = (title: string, collection: CollectionDoc) => {
	const prefix = `${collection.data.title}, `;
	return collection.data.kind === "series" && title.startsWith(prefix)
		? title.slice(prefix.length)
		: title;
};

const slides = collections.map((collection) => {
	const shown = previewCollectionPosts(collection, posts, SLIDE_POSTS);
	const ordered = collection.data.kind === "series";
	return {
		collection,
		href: collectionHref(collection),
		ordered,
		listId: `collection-posts-${collection.id}`,
		listLabel: ordered ? collectionsCopy.parts : collectionsCopy.recentPosts,
		allLabel: collectionsCopy.all(collection.data.posts.length),
		allName: collectionsCopy.allIn(collectionCountLabel(collection), collection.data.title),
		items: shown.map((post) => ({
			href: getPostHref(post),
			title: shortTitle(post.data.title, collection),
		})),
	};
});
---

<section class="collections" aria-labelledby="collections-label">
	<div class="collections-head">
		<div class="section-label" id="collections-label">{collectionsCopy.title}</div>
		<div class="carousel-controls">
			<button
				type="button"
				class="carousel-btn"
				aria-label={collectionsCopy.previous}
				aria-controls="collections-track"
				aria-disabled="true"
				data-carousel-prev
			>
				<svg
					viewBox="0 0 24 24"
					width="16"
					height="16"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"><path d="M14.5 6l-6 6l6 6"></path></svg
				>
			</button>
			<button
				type="button"
				class="carousel-btn"
				aria-label={collectionsCopy.next}
				aria-controls="collections-track"
				data-carousel-next
			>
				<svg
					viewBox="0 0 24 24"
					width="16"
					height="16"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"><path d="M9.5 6l6 6l-6 6"></path></svg
				>
			</button>
		</div>
	</div>

	<ul
		class="track"
		id="collections-track"
		role="list"
		style={`--cover-height: ${COVER_HEIGHT}px`}
		data-carousel-track
	>
		{
			slides.map((slide) => {
				const PostsList = slide.ordered ? "ol" : "ul";
				return (
					<li class="slide">
						<a class="slide-art" href={slide.href} tabindex="-1" aria-hidden="true">
							<CollectionCover
								src={slide.collection.data.cover}
								height={artHeight(slide.collection.data.cover)}
							/>
						</a>
						<h3 class="slide-title">
							<a href={slide.href} data-astro-prefetch>
								{slide.collection.data.title}
							</a>
						</h3>
						<p class="slide-desc">
							{slide.collection.data.shortDescription ?? slide.collection.data.description}
						</p>
						<div class="slide-list-head">
							<span id={slide.listId}>{slide.listLabel}</span>
							<a class="slide-all" href={slide.href} aria-label={slide.allName} data-astro-prefetch>
								{slide.allLabel}
								<Icon name="tabler:arrow-right" aria-hidden="true" />
							</a>
						</div>
						<PostsList class="slide-posts" role="list" aria-labelledby={slide.listId}>
							{slide.items.map((item) => (
								<li>
									<a href={item.href} title={item.title} data-astro-prefetch>
										<span>{item.title}</span>
									</a>
								</li>
							))}
						</PostsList>
					</li>
				);
			})
		}
	</ul>
</section>

<script>
	function initCarousel() {
		const track = document.querySelector<HTMLElement>("[data-carousel-track]");
		const prev = document.querySelector<HTMLButtonElement>("[data-carousel-prev]");
		const next = document.querySelector<HTMLButtonElement>("[data-carousel-next]");
		if (!track || !prev || !next) return;

		const slides = Array.from(track.children) as HTMLElement[];
		const first = slides[0];
		const last = slides[slides.length - 1];
		if (!first || !last) return;

		const end = () =>
			Math.max(
				0,
				Math.min(track.scrollWidth - track.clientWidth, last.offsetLeft - first.offsetLeft),
			);
		const step = () => (slides[1] ? slides[1].offsetLeft - first.offsetLeft : track.clientWidth);

		const update = () => {
			const atStart = track.scrollLeft <= 1;
			const atEnd = track.scrollLeft >= end() - 1;
			prev.setAttribute("aria-disabled", String(atStart));
			next.setAttribute("aria-disabled", String(atEnd));
			track.toggleAttribute("data-scrolled", !atStart);
			track.toggleAttribute("data-at-end", atEnd);
		};

		const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
		let target: number | null = null;
		let settle = 0;

		const bind = (button: HTMLButtonElement, dir: number) =>
			button.addEventListener("click", () => {
				if (button.getAttribute("aria-disabled") === "true") return;
				const size = step();
				const from = target ?? track.scrollLeft;
				target = Math.max(0, Math.min(end(), (Math.round(from / size) + dir) * size));
				track.scrollTo({ left: target, behavior: reduced.matches ? "auto" : "smooth" });
			});

		bind(prev, -1);
		bind(next, 1);

		track.addEventListener("focusin", (event) => {
			const link = event.target as HTMLElement;
			const slide = slides.find((s) => s.contains(link));
			if (!slide || !link.matches(":focus-visible")) return;
			const box = track.getBoundingClientRect();
			const rect = slide.getBoundingClientRect();
			if (rect.left >= box.left - 1 && rect.right <= box.right + 1) return;
			track.scrollTo({ left: Math.min(end(), slide.offsetLeft - first.offsetLeft) });
		});

		let frame = 0;
		track.addEventListener(
			"scroll",
			() => {
				cancelAnimationFrame(frame);
				frame = requestAnimationFrame(update);
				window.clearTimeout(settle);
				settle = window.setTimeout(() => {
					target = null;
				}, 150);
			},
			{ passive: true },
		);
		new ResizeObserver(update).observe(track);
		update();
	}

	initCarousel();
</script>

<style>
	.collections {
		display: flow-root;
		margin-bottom: 84px;
	}
	.collections-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		margin-bottom: 28px;
	}
	.collections-head .section-label {
		margin-bottom: 0;
	}
	.carousel-controls {
		display: flex;
		gap: 8px;
		margin-block: -7px;
	}
	.carousel-btn {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		padding: 0;
		border: 1px solid var(--hairline);
		border-radius: 50%;
		background: transparent;
		color: hsl(var(--theme-text-muted));
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
		transition:
			color 0.2s ease,
			border-color 0.2s ease,
			opacity 0.2s ease;
	}
	.carousel-btn::before {
		content: "";
		position: absolute;
		inset: -6px -4px;
	}
	.carousel-btn:hover {
		border-color: hsl(var(--theme-accent));
		color: hsl(var(--theme-accent));
	}
	.carousel-btn:focus-visible {
		outline: 2px solid hsl(var(--theme-accent));
		outline-offset: 3px;
	}
	.carousel-btn[aria-disabled="true"] {
		border-color: var(--hairline);
		color: hsl(var(--theme-text-muted));
		opacity: 0.4;
		cursor: default;
	}
	@media (prefers-reduced-motion: no-preference) {
		.carousel-btn {
			transition:
				color 0.2s ease,
				border-color 0.2s ease,
				opacity 0.2s ease,
				transform 0.18s ease;
		}
		.carousel-btn:not([aria-disabled="true"]):active {
			transform: scale(0.96);
		}
	}

	.track {
		--slide-gap: 56px;
		--slide-peek: 24px;
		--bleed-start: 8px;
		--bleed-end: 16px;
		--fade-start: 0px;
		--fade-end: calc(var(--slide-peek) + var(--bleed-end));
		display: flex;
		gap: var(--slide-gap);
		margin: -4px calc(-1 * var(--bleed-end)) -6px calc(-1 * var(--bleed-start));
		padding: 4px var(--bleed-end) 6px var(--bleed-start);
		list-style: none;
		overflow-x: auto;
		overflow-y: hidden;
		scroll-snap-type: x mandatory;
		scroll-padding-inline: var(--bleed-start) var(--bleed-end);
		scrollbar-width: none;
		mask-image: linear-gradient(
			to right,
			transparent,
			#000 var(--fade-start),
			#000 calc(100% - var(--fade-end)),
			transparent
		);
	}
	.track[data-scrolled] {
		--fade-start: var(--bleed-start);
	}
	.track[data-at-end] {
		--fade-end: 0px;
	}
	.track:has(a:focus-visible) {
		--fade-start: 0px;
	}
	.track::-webkit-scrollbar {
		display: none;
	}
	.track::after {
		content: "";
		flex: 0 0 var(--slide-peek);
	}
	.slide {
		position: relative;
		flex: 0 0 calc((100% - 2 * var(--slide-gap) - var(--slide-peek)) / 2);
		min-width: 0;
		scroll-snap-align: start;
	}
	.slide + .slide::before {
		content: "";
		position: absolute;
		inset-block: 0;
		left: calc(var(--slide-gap) / -2);
		width: 1px;
		background: var(--hairline);
	}
	.slide a {
		-webkit-tap-highlight-color: transparent;
	}
	.slide a:focus-visible {
		outline: 2px solid hsl(var(--theme-accent));
		outline-offset: 2px;
		border-radius: 3px;
	}
	.slide a:active {
		opacity: 0.7;
	}
	.slide-art {
		display: flex;
		align-items: center;
		justify-content: center;
		height: var(--cover-height);
		margin-bottom: 8px;
		padding-inline: 16px;
		border-radius: 4px;
		isolation: isolate;
		background-color: var(--surface);
		transition: background-color 0.35s ease;
	}
	.slide-title {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--title-m);
		font-weight: var(--title-weight);
		line-height: 1.3;
		letter-spacing: -0.011em;
	}
	.slide-title a {
		display: inline-block;
		margin-inline: -4px;
		padding: 3px 4px;
		color: hsl(var(--theme-text));
	}
	.slide-title a:focus-visible {
		outline-offset: 0;
	}
	.slide-title a:hover,
	.slide-art:hover + .slide-title a,
	.slide-posts a:hover,
	.slide-all:hover {
		color: hsl(var(--theme-accent));
	}
	.slide-desc {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		line-clamp: 3;
		overflow: hidden;
		min-height: 2.9em;
		margin: 2px 0 0;
		font-size: var(--text-small);
		line-height: 1.45;
		color: hsl(var(--theme-text-muted));
		text-wrap: pretty;
	}
	.slide-list-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 12px;
		margin-top: 14px;
		padding-bottom: 6px;
		font-size: var(--text-meta);
		font-weight: 500;
		line-height: 1.4;
		color: hsl(var(--theme-text-muted));
	}
	.slide-all {
		display: inline-flex;
		align-items: center;
		gap: 0.3em;
		margin-block: -6px;
		padding-block: 6px;
		color: inherit;
		font-variant-numeric: tabular-nums;
	}
	.slide-all :global(svg) {
		width: 1em;
		height: 1em;
	}
	.slide-posts {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.slide-posts li {
		border-top: 1px solid var(--hairline);
	}
	.slide-posts a {
		display: block;
		padding-block: 7px;
		font-size: var(--text-small);
		font-weight: 500;
		line-height: 1.3334;
		color: hsl(var(--theme-text));
	}
	.slide-posts span {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		overflow: hidden;
		text-wrap: pretty;
	}

	@media (max-width: 720px) {
		.collections {
			margin-bottom: 64px;
		}
		.track {
			--slide-gap: calc(2 * var(--bleed-start) + 2px);
			--bleed-start: max(22px, env(safe-area-inset-left));
			--bleed-end: max(22px, env(safe-area-inset-right));
		}
	}

	@media (max-width: 560px) {
		.slide {
			flex-basis: calc(100% - var(--slide-gap) - var(--slide-peek));
		}
	}

	@media (max-width: 420px) {
		.collections-head {
			margin-bottom: 26px;
		}
		.track {
			--bleed-start: max(16px, env(safe-area-inset-left));
			--bleed-end: max(16px, env(safe-area-inset-right));
		}
	}
</style>
