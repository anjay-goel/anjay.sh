---
import Thumbnail from "@/components/art/Thumbnail.astro";
import Waveform from "@/components/art/Waveform.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { homeCopy } from "@/content/copy/home";
import { metaCopy } from "@/content/copy/meta";
import type { PostSummary } from "@/data/post";
import { externalSourceFor, getPostExtras } from "@/data/post-extras";
import { formatDayMonthYear } from "@/utils/date";
import { withBase } from "@/utils/path";

interface Props {
	featured: PostSummary;
	recent: PostSummary[];
	total: number;
}

const { featured, recent, total } = Astro.props;
const copy = homeCopy.latest;
const allHref = withBase("/posts/");
const allText = copy.allPosts(total);

const labelFor = (post: PostSummary) =>
	getPostExtras(post.id).homeLabel ?? post.collection?.data.homeLabel ?? post.label?.text;

const sourceFor = (post: PostSummary) => (post.external ? externalSourceFor(post.href) : undefined);

const featuredLabel = labelFor(featured);
const featuredSource = sourceFor(featured);
const linkAttrs = (post: PostSummary) =>
	post.external ? { rel: "noopener" } : { "data-astro-prefetch": true };
---

<section class="latest" aria-labelledby="latest-h">
	<SectionHeading id="latest-h" title={copy.title} href={allHref} linkText={allText} class="latest-heading" />
	<div class="latest-grid">
		<article class="featured">
			<a class="featured-link" href={featured.href} data-post-row {...linkAttrs(featured)}>
				{
					featured.thumbnail && (
						<div class="featured-visual" aria-hidden="true">
							{featured.thumbnail === "dub" ? (
								<div class="featured-wave">
									<Waveform />
								</div>
							) : (
								<div class="featured-thumb">
									<Thumbnail name={featured.thumbnail} part={featured.part?.roman} />
								</div>
							)}
						</div>
					)
				}
				<p class="meta featured-meta">
					<time datetime={featured.date.toISOString()}>{formatDayMonthYear(featured.date)}</time>
					{featuredLabel && <>{metaCopy.separator}{featuredLabel}</>}
					{featuredSource && <span class="featured-source">{metaCopy.separator}{featuredSource}</span>}
				</p>
				<h3 class="featured-title">
					{featured.title}
					{featured.external && <span class="sr-only">{metaCopy.externalSr}</span>}
				</h3>
				<p class="featured-desc">{featured.description}</p>
			</a>
		</article>
		<ul class="recent" role="list">
			{
				recent.map((post) => {
					const label = labelFor(post);
					return (
						<li class="recent-item">
							<a class="recent-link" href={post.href} data-post-row {...linkAttrs(post)}>
								<p class="meta recent-meta">
									<time datetime={post.date.toISOString()}>{formatDayMonthYear(post.date)}</time>
									{label && <>{metaCopy.separator}{label}</>}
								</p>
								<h3 class="recent-title">
									{post.title}
									{post.external && <span class="sr-only">{metaCopy.externalSr}</span>}
								</h3>
								<p class="recent-desc">{post.description}</p>
							</a>
						</li>
					);
				})
			}
		</ul>
	</div>
	<a class="btn-secondary latest-all" href={allHref} data-astro-prefetch>{allText}</a>
</section>

<style>
	.latest {
		padding-bottom: 7rem;
	}
	.latest-grid {
		display: flex;
		flex-wrap: wrap;
		gap: 3.5rem;
	}
	.featured {
		flex: 999 1 27.5rem;
		min-width: 0;
	}
	.featured-link,
	.recent-link {
		display: block;
		color: inherit;
		text-decoration: none;
		scroll-margin-block: 6rem;
	}
	.featured-link:focus-visible,
	.recent-link:focus-visible {
		outline-offset: 0.5rem;
		border-radius: var(--radius-md);
	}
	.featured-visual {
		position: relative;
		height: 12rem;
		border: 1px solid var(--rule);
		border-radius: var(--radius-lg);
		background: var(--panel);
		overflow: hidden;
	}
	.featured-wave {
		position: absolute;
		inset: 2.25rem 2rem;
	}
	.featured-thumb {
		position: absolute;
		inset: 1.5rem;
	}
	.featured-meta,
	.recent-meta {
		line-height: 1.3;
	}
	.featured-meta {
		margin: 0 0 0.75rem;
	}
	.featured-visual + .featured-meta {
		margin-top: 1.25rem;
	}
	.featured-title {
		margin: 0;
		font-size: var(--text-34);
		line-height: 1.1;
		letter-spacing: -0.022em;
		text-wrap: balance;
		transition: color var(--dur) var(--ease);
	}
	.featured-desc {
		max-width: 36em;
		margin: 1rem 0 0;
		font-size: var(--text-18);
		line-height: 1.6;
		color: var(--muted);
		text-wrap: pretty;
	}
	.featured-link:hover .featured-title,
	.recent-link:hover .recent-title {
		color: var(--accent);
	}
	.recent {
		flex: 1 1 20rem;
		min-width: 0;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.recent-item {
		padding: 1.125rem 0;
		border-bottom: 1px solid var(--rule);
	}
	.recent-item:first-child {
		padding-top: 0;
	}
	.recent-item:last-child {
		padding-bottom: 0;
		border-bottom: 0;
	}
	.recent-meta {
		margin: 0 0 0.5rem;
	}
	.recent-title {
		margin: 0;
		font-size: var(--text-21);
		line-height: 1.25;
		letter-spacing: -0.012em;
		text-wrap: balance;
		transition: color var(--dur) var(--ease);
	}
	.recent-desc {
		max-width: 36em;
		margin: 0.5rem 0 0;
		font-size: var(--text-16);
		line-height: 1.55;
		color: var(--muted);
		text-wrap: pretty;
	}
	.latest-all {
		display: none;
	}
	@media (max-width: 767px) {
		.latest {
			padding-bottom: 3.5rem;
		}
		.latest :global(.latest-heading .section-heading-action) {
			display: none;
		}
		.latest-grid {
			display: block;
		}
		.featured-visual {
			height: 11rem;
			border-radius: var(--radius-xl);
		}
		.featured-wave {
			inset: 1.5rem 1.125rem;
		}
		.featured-thumb {
			inset: 1rem;
		}
		.featured-meta {
			margin-bottom: 0.5rem;
		}
		.featured-visual + .featured-meta {
			margin-top: 1.125rem;
		}
		.featured-source {
			display: none;
		}
		.featured-title {
			font-size: var(--text-21);
			line-height: 1.12;
			letter-spacing: -0.018em;
		}
		.featured-desc {
			margin-top: 0.625rem;
			font-size: var(--text-16);
			line-height: 1.55;
		}
		.recent {
			margin-top: 1.75rem;
			border-top: 1px solid var(--rule);
		}
		.recent-item,
		.recent-item:first-child,
		.recent-item:last-child {
			padding: 1.125rem 0;
			border-bottom: 1px solid var(--rule);
		}
		.recent-meta {
			margin: 0;
		}
		.recent-title {
			margin-top: 0.375rem;
			font-size: var(--text-18);
			font-weight: 400;
			text-wrap: wrap;
			line-height: 1.3;
			letter-spacing: 0;
		}
		.recent-desc {
			display: none;
		}
		.latest-all {
			display: flex;
			margin-top: 1.25rem;
		}
	}
</style>
