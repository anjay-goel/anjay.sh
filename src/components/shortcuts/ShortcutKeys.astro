---
import Kbd from "@/components/ui/Kbd.astro";
import { shortcutsCopy } from "@/content/copy/shortcuts";
import { type ShortcutId, shortcuts } from "@/data/shortcuts";

interface Props {
	id: ShortcutId;
}

const { id } = Astro.props;
const shortcut = shortcuts.find((s) => s.id === id);
if (!shortcut) throw new Error(`Unknown shortcut: ${id}`);
const joiner = shortcut.join ? shortcutsCopy.joins[shortcut.join] : undefined;
---

<span class="shortcut-keys">{shortcut.keys.map((key, i) => <>{i > 0 && joiner && <span class="shortcut-join">{joiner}</span>}<Kbd>{shortcutsCopy.keyLabel(key)}</Kbd></>)}</span>

<style>
	.shortcut-keys {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
	}
	.shortcut-join {
		font-family: var(--font-sans);
		font-size: var(--text-12);
		line-height: 1;
		color: var(--soft);
	}
</style>
