---
import ShortcutKeys from "@/components/shortcuts/ShortcutKeys.astro";
import Kbd from "@/components/ui/Kbd.astro";
import { shortcutsCopy } from "@/content/copy/shortcuts";
import { shortcutKeys, shortcuts } from "@/data/shortcuts";
import { withBase } from "@/utils/path";
---

<dialog
	class="shortcuts"
	aria-labelledby="shortcuts-title"
	tabindex="-1"
	data-shortcuts-dialog
	data-home={withBase("/")}
	data-posts={withBase("/posts/")}
>
	<div class="shortcuts-head">
		<h2 class="shortcuts-title" id="shortcuts-title">{shortcutsCopy.title}</h2>
		<button class="shortcuts-close" type="button" aria-label={shortcutsCopy.closeLabel} data-shortcuts-close>
			<Kbd>{shortcutsCopy.keyLabel(shortcutKeys.close)}</Kbd>
		</button>
	</div>
	<dl class="shortcuts-list">
		{
			shortcuts.map((shortcut) => (
				<div class="shortcuts-row">
					<dt class="shortcuts-keys">
						<ShortcutKeys id={shortcut.id} />
					</dt>
					<dd class="shortcuts-action">{shortcutsCopy.actions[shortcut.id]}</dd>
				</div>
			))
		}
	</dl>
	<p class="shortcuts-note">{shortcutsCopy.note}</p>
</dialog>

<style>
	.shortcuts {
		box-sizing: border-box;
		width: min(33.75rem, calc(100vw - 2 * var(--gutter)));
		max-width: none;
		max-height: calc(100dvh - 11.25rem);
		margin: 9.375rem auto auto;
		padding: 1.375rem 1.625rem 1.125rem;
		overflow-y: auto;
		overscroll-behavior: contain;
		border: 1px solid var(--rule);
		border-radius: 0.875rem;
		background: var(--paper);
		color: var(--ink);
		font-family: var(--font-sans);
	}
	.shortcuts:focus-visible {
		outline: none;
	}
	.shortcuts::backdrop {
		background: rgba(26, 26, 26, 0.3);
	}
	:global(:root[data-theme="dark"]) .shortcuts::backdrop {
		background: rgba(0, 0, 0, 0.62);
	}
	.shortcuts-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.875rem;
	}
	.shortcuts-title {
		margin: 0;
		font-size: var(--text-18);
		font-weight: 600;
		line-height: 1.3;
	}
	.shortcuts-close {
		display: inline-flex;
		flex: none;
		padding: 0;
		border: 0;
		background: transparent;
	}
	.shortcuts-close:hover :global(.kbd) {
		border-color: var(--accent);
		color: var(--accent);
	}
	.shortcuts-close:focus-visible {
		outline-offset: 2px;
		border-radius: var(--radius-md);
	}
	.shortcuts-list {
		margin: 0;
	}
	.shortcuts-row {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 0.625rem 0;
		border-top: 1px solid var(--rule);
	}
	.shortcuts-keys {
		display: flex;
		flex: 0 0 9.375rem;
		align-items: center;
	}
	.shortcuts-action {
		margin: 0;
		font-size: var(--text-16);
		line-height: 1.5;
		color: var(--muted);
	}
	.shortcuts-note {
		margin: 0.875rem 0 0;
		padding-top: 0.75rem;
		border-top: 1px solid var(--rule);
		font-size: var(--text-14);
		line-height: 1.3;
		color: var(--soft);
	}

	@media (max-width: 767px) {
		.shortcuts {
			max-height: calc(100dvh - 2 * var(--gutter));
			margin: auto;
			padding: 1.125rem 1.25rem 1rem;
		}
		.shortcuts-keys {
			flex-basis: 7rem;
		}
	}
</style>
