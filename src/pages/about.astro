---
import { Picture } from "astro:assets";
import { getEntry, render } from "astro:content";
import avatar from "@/assets/avatar.png";
import JsonLd from "@/components/JsonLd.astro";
import Socials from "@/components/ui/Socials.astro";
import { aboutCopy, education } from "@/content/copy/about";
import { metaCopy } from "@/content/copy/meta";
import { getAllPosts, getPostYears, type MetaPart } from "@/data/post";
import { showcase } from "@/data/showcase";
import PageLayout from "@/layouts/Base.astro";
import { siteConfig } from "@/site-config";
import { absoluteUrl } from "@/utils/path";

const entry = await getEntry("page", "about");
if (!entry) throw new Error("Missing src/content/page/about.md");
const { Content } = await render(entry);

const profile = siteConfig.profile;
const authorName = profile?.name ?? siteConfig.author;

const meta = {
	description: entry.data.description ?? siteConfig.description,
	title: entry.data.title,
};

const personSameAs = [profile?.linkedin, profile?.github, profile?.twitter, profile?.mastodon].filter(
	(s): s is string => Boolean(s),
);

const avatarUrl = absoluteUrl(avatar.src, Astro.site);

const posts = await getAllPosts();
const firstYear = getPostYears(posts).at(-1);
const { heading, photoAlt, factsLabel } = entry.data;

const shipped = showcase
	.filter((item) => item.reach)
	.flatMap((item, i): MetaPart[] => [
		`${i > 0 ? metaCopy.separator : ""}${item.name} `,
		{ text: item.reach ?? "", accent: true },
	]);

const factParts = (fact: (typeof entry.data.facts)[number]): MetaPart[] => {
	if ("text" in fact) return [fact.text];
	if (fact.source === "shipped") return shipped;
	if (fact.source === "education") return [education];
	return firstYear ? [aboutCopy.writing(posts.length, firstYear)] : [];
};

const facts = entry.data.facts
	.map((fact) => ({
		term: fact.term,
		parts: factParts(fact).map((p) =>
			typeof p === "string" ? { text: p, accent: false } : { text: p.text, accent: Boolean(p.accent) },
		),
	}))
	.filter((fact) => fact.parts.length > 0);
---

<PageLayout meta={meta}>
	<JsonLd
		slot="head"
		item={{
			"@context": "https://schema.org",
			"@type": "ProfilePage",
			mainEntity: {
				"@type": "Person",
				name: authorName,
				image: avatarUrl,
				...(profile?.jobTitle ? { jobTitle: profile.jobTitle } : {}),
				...(profile?.employer
					? {
							worksFor: {
								"@type": "Organization",
								name: profile.employer,
								...(profile.employerUrl ? { url: profile.employerUrl } : {}),
							},
						}
					: {}),
				...(profile?.alumni
					? {
							alumniOf: {
								"@type": "CollegeOrUniversity",
								name: profile.alumni,
							},
						}
					: {}),
				...(personSameAs.length ? { sameAs: personSameAs } : {}),
			},
		}}
	/>
	<section class="about">
		<Picture
			src={avatar}
			alt={photoAlt ?? authorName}
			formats={["avif", "webp"]}
			widths={[132, 262, 264, 524]}
			sizes="(max-width: 767px) 132px, 262px"
			width={262}
			height={262}
			loading="eager"
			fetchpriority="high"
			class="about-photo"
			pictureAttributes={{ class: "about-picture" }}
		/>
		<div class="about-text">
			<h1 class="about-heading">{heading ?? entry.data.title}</h1>
			<div class="about-body">
				<Content />
			</div>
			<dl class="about-facts" aria-label={factsLabel}>
				{
					facts.map((fact) => (
						<div class="about-fact">
							<dt>{fact.term}</dt>
							<dd>
								{fact.parts.map((p) => (p.accent ? <span class="about-fact-accent">{p.text}</span> : p.text))}
							</dd>
						</div>
					))
				}
			</dl>
			<Socials class="about-socials about-socials-inline" />
			<Socials class="about-socials about-socials-boxed" variant="boxed" label={false} />
		</div>
	</section>
</PageLayout>

<style>
	.about {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		gap: 3.5rem;
		padding: 5rem 0 7.5rem;
	}
	.about :global(.about-picture) {
		display: block;
		flex: 0 0 16.375rem;
	}
	.about :global(.about-photo) {
		display: block;
		width: 16.375rem;
		height: 16.375rem;
		box-sizing: border-box;
		border: 1px solid var(--rule);
		border-radius: 1.25rem;
		object-fit: cover;
		background: var(--panel);
	}
	.about-text {
		flex: 1 1 32.5rem;
		max-width: 40rem;
		min-width: 0;
	}
	.about-heading {
		margin: 0;
		font-size: var(--text-64);
		font-weight: 600;
		line-height: 1.02;
		letter-spacing: -0.028em;
	}
	.about-body {
		margin-top: 1.75rem;
		font-family: var(--font-serif);
		font-size: var(--text-21);
		line-height: 1.7;
		color: var(--ink);
	}
	.about-body :global(p),
	.about-body :global(ul),
	.about-body :global(ol) {
		margin: 1.25rem 0 0;
		text-wrap: pretty;
	}
	.about-body :global(ul),
	.about-body :global(ol) {
		padding: 0;
		list-style: none;
	}
	.about-body :global(li + li) {
		margin-top: 1.25rem;
	}
	.about-body > :global(:first-child) {
		margin-top: 0;
	}
	.about-body :global(a) {
		color: var(--accent);
		text-decoration-line: underline;
		text-decoration-thickness: 1px;
		text-decoration-color: var(--link-line);
		text-underline-offset: 0.1875rem;
	}
	.about-body :global(a:hover) {
		text-decoration-thickness: 2px;
		text-decoration-color: var(--accent);
	}
	.about-facts {
		display: grid;
		grid-template-columns: 7.5rem minmax(0, 1fr);
		gap: 0.625rem 1rem;
		margin: 2.25rem 0 0;
		padding: 1.125rem 0 0;
		border-top: 1px solid var(--rule-strong);
		font-family: var(--font-mono);
		font-size: var(--text-14);
		line-height: 1.55;
	}
	.about-fact {
		display: contents;
	}
	.about-facts dt {
		color: var(--ink);
	}
	.about-facts dd {
		margin: 0;
		color: var(--muted);
	}
	.about-fact-accent {
		color: var(--accent);
	}
	.about-text :global(.about-socials-inline) {
		margin-top: 2rem;
		font-family: var(--font-serif);
	}
	.about-text :global(.about-socials-inline .socials-label) {
		margin-right: 0.75rem;
	}
	.about-text :global(.about-socials-boxed) {
		display: none;
	}

	@media (max-width: 767px) {
		.about {
			display: block;
			padding: 2.5rem 0 3.5rem;
		}
		.about :global(.about-photo) {
			width: 8.25rem;
			height: 8.25rem;
			margin-bottom: 1.5rem;
			border-radius: var(--radius-xl);
		}
		.about-heading {
			font-size: var(--text-34);
		}
		.about-body {
			margin-top: 1.25rem;
			font-size: var(--text-18);
		}
		.about-body :global(p),
		.about-body :global(ul),
		.about-body :global(ol),
		.about-body :global(li + li) {
			margin-top: 1rem;
		}
		.about-facts {
			grid-template-columns: 6rem minmax(0, 1fr);
			margin-top: 1.75rem;
			font-size: var(--text-12);
		}
		.about-text :global(.about-socials-inline) {
			display: none;
		}
		.about-text :global(.about-socials-boxed) {
			display: flex;
			margin-top: 1.5rem;
		}
	}
</style>
