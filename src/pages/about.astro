---
import { Picture } from "astro:assets";
import { getEntry, render } from "astro:content";
import avatar from "@/assets/avatar.png";
import Socials from "@/components/ui/Socials.astro";
import { aboutCopy as copy } from "@/content/copy/about";
import { getAllPosts, getPostYears } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { siteConfig } from "@/site-config";
import { absoluteUrl } from "@/utils/path";
import JsonLd from "@/components/JsonLd.astro";

const entry = await getEntry("page", "about");
if (!entry) throw new Error("Missing src/content/page/about.md");
const { Content } = await render(entry);

const profile = siteConfig.profile;
const authorName = profile?.name ?? siteConfig.author;

const meta = {
	description: entry.data.description ?? siteConfig.description,
	title: entry.data.title,
};

const personSameAs = [profile?.linkedin, profile?.github, profile?.twitter, profile?.mastodon].filter(
	(s): s is string => Boolean(s),
);

const avatarUrl = absoluteUrl(avatar.src, Astro.site);

const posts = await getAllPosts();
const firstYear = getPostYears(posts).at(-1);
const facts = [
	...copy.facts,
	...(firstYear ? [{ term: copy.writing.term, parts: [copy.writing.text(posts.length, firstYear)] }] : []),
];
const partsOf = (parts: (typeof facts)[number]["parts"]) =>
	parts.map((p) => (typeof p === "string" ? { text: p, accent: false } : { text: p.text, accent: Boolean(p.accent) }));
---

<PageLayout meta={meta}>
	<JsonLd
		slot="head"
		item={{
			"@context": "https://schema.org",
			"@type": "ProfilePage",
			mainEntity: {
				"@type": "Person",
				name: authorName,
				image: avatarUrl,
				...(profile?.jobTitle ? { jobTitle: profile.jobTitle } : {}),
				...(profile?.employer
					? {
							worksFor: {
								"@type": "Organization",
								name: profile.employer,
								...(profile.employerUrl ? { url: profile.employerUrl } : {}),
							},
						}
					: {}),
				...(profile?.alumni
					? {
							alumniOf: {
								"@type": "CollegeOrUniversity",
								name: profile.alumni,
							},
						}
					: {}),
				...(personSameAs.length ? { sameAs: personSameAs } : {}),
			},
		}}
	/>
	<section class="about">
		<Picture
			src={avatar}
			alt={copy.photoAlt}
			formats={["avif", "webp"]}
			widths={[132, 264, 260, 520]}
			sizes="(max-width: 767px) 132px, 260px"
			width={260}
			height={260}
			loading="eager"
			fetchpriority="high"
			class="about-photo"
			pictureAttributes={{ class: "about-picture" }}
		/>
		<div class="about-text">
			<h1 class="about-heading">{copy.heading}</h1>
			<div class="about-body">
				<Content />
			</div>
			<dl class="about-facts" aria-label={copy.factsLabel}>
				{
					facts.map((fact) => (
						<div class="about-fact">
							<dt>{fact.term}</dt>
							<dd>
								{partsOf(fact.parts).map((p) => (p.accent ? <span class="about-fact-accent">{p.text}</span> : p.text))}
							</dd>
						</div>
					))
				}
			</dl>
			<Socials class="about-socials about-socials-inline" />
			<Socials class="about-socials about-socials-boxed" variant="boxed" label={false} />
		</div>
	</section>
</PageLayout>

<style>
	.about {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		gap: 56px;
		padding: 80px 0 120px;
	}
	.about :global(.about-picture) {
		display: block;
		flex: 0 0 260px;
	}
	.about :global(.about-photo) {
		display: block;
		width: 260px;
		height: 260px;
		box-sizing: border-box;
		border: 1px solid var(--rule);
		border-radius: 20px;
		object-fit: cover;
		background: var(--panel);
	}
	.about-text {
		flex: 1 1 520px;
		max-width: 640px;
		min-width: 0;
	}
	.about-heading {
		margin: 0;
		font-size: var(--text-64);
		font-weight: 600;
		line-height: 1.02;
		letter-spacing: -0.028em;
	}
	.about-body {
		margin-top: 28px;
		font-family: var(--font-serif);
		font-size: var(--text-21);
		line-height: 1.7;
		color: var(--ink);
	}
	.about-body :global(p),
	.about-body :global(ul),
	.about-body :global(ol) {
		margin: 20px 0 0;
		text-wrap: pretty;
	}
	.about-body :global(ul),
	.about-body :global(ol) {
		padding: 0;
		list-style: none;
	}
	.about-body :global(li + li) {
		margin-top: 20px;
	}
	.about-body > :global(:first-child) {
		margin-top: 0;
	}
	.about-body :global(a) {
		color: var(--accent);
		text-decoration-line: underline;
		text-decoration-thickness: 1px;
		text-decoration-color: var(--link-line);
		text-underline-offset: 3px;
	}
	.about-body :global(a:hover) {
		text-decoration-thickness: 2px;
		text-decoration-color: var(--accent);
	}
	.about-facts {
		display: grid;
		grid-template-columns: 120px minmax(0, 1fr);
		gap: 10px 16px;
		margin: 36px 0 0;
		padding: 18px 0 0;
		border-top: 1px solid var(--rule-strong);
		font-family: var(--font-mono);
		font-size: var(--text-14);
		line-height: 1.55;
	}
	.about-fact {
		display: contents;
	}
	.about-facts dt {
		color: var(--ink);
	}
	.about-facts dd {
		margin: 0;
		color: var(--muted);
	}
	.about-fact-accent {
		color: var(--accent);
	}
	.about-text :global(.about-socials-inline) {
		margin-top: 32px;
		font-family: var(--font-serif);
	}
	.about-text :global(.about-socials-inline .socials-label) {
		margin-right: 12px;
	}
	.about-text :global(.about-socials-boxed) {
		display: none;
	}

	@media (max-width: 767px) {
		.about {
			display: block;
			padding: 40px 0 56px;
		}
		.about :global(.about-photo) {
			width: 132px;
			height: 132px;
			margin-bottom: 24px;
			border-radius: var(--radius-xl);
		}
		.about-heading {
			font-size: var(--text-44);
		}
		.about-body {
			margin-top: 20px;
			font-size: var(--text-18);
		}
		.about-body :global(p),
		.about-body :global(ul),
		.about-body :global(ol),
		.about-body :global(li + li) {
			margin-top: 16px;
		}
		.about-facts {
			grid-template-columns: 96px minmax(0, 1fr);
			margin-top: 28px;
			font-size: var(--text-12);
		}
		.about-text :global(.about-socials-inline) {
			display: none;
		}
		.about-text :global(.about-socials-boxed) {
			display: flex;
			margin-top: 24px;
		}
	}
</style>
