---
import ColophonParts from "@/components/colophon/ColophonParts.astro";
import Kbd from "@/components/ui/Kbd.astro";
import { colophonCopy as copy } from "@/content/copy/colophon";
import PageLayout from "@/layouts/Base.astro";
---

<PageLayout meta={{ title: copy.title, description: copy.description }}>
	<section class="colophon">
		<h1 class="page-title colophon-title">{copy.title}</h1>
		<p class="colophon-dek">{copy.dek}</p>
		<dl class="colophon-rows">
			{
				copy.rows.map((row) => (
					<div class="colophon-row">
						<dt>{row.term}</dt>
						<dd>
							<ColophonParts parts={row.parts} />
						</dd>
					</div>
				))
			}
		</dl>
		<section class="keyboard" aria-labelledby="keyboard-h">
			<h2 id="keyboard-h" class="keyboard-heading">{copy.keyboard.heading}</h2>
			<p class="keyboard-intro"><ColophonParts parts={copy.keyboard.intro} /></p>
			<ul class="shortcuts">
				{
					copy.keyboard.shortcuts.map((s) => (
						<li class="shortcut">
							<span class="shortcut-keys">
								{s.keys.map((k, i) => (
									<>
										{i > 0 && s.joiner && <span class="shortcut-joiner">{s.joiner}</span>}
										<Kbd>{k}</Kbd>
									</>
								))}
							</span>
							<span class="shortcut-label">{s.label}</span>
						</li>
					))
				}
			</ul>
		</section>
	</section>
</PageLayout>

<style>
	.colophon {
		max-width: 820px;
		padding: 80px 0 120px;
	}
	.colophon-title {
		line-height: 1.02;
		letter-spacing: -0.028em;
	}
	.colophon-dek {
		margin: 20px 0 0;
		font-family: var(--font-serif);
		font-size: var(--text-21);
		line-height: 1.6;
		color: var(--muted);
	}
	.colophon-rows {
		display: grid;
		grid-template-columns: 180px minmax(0, 1fr);
		margin: 48px 0 0;
		border-top: 1px solid var(--rule-strong);
	}
	.colophon-row {
		display: contents;
	}
	.colophon-rows dt {
		padding: 20px 0;
		border-bottom: 1px solid var(--rule);
		font-size: var(--text-16);
		font-weight: 600;
		line-height: 1.3;
		color: var(--ink);
	}
	.colophon-rows dd {
		margin: 0;
		padding: 20px 0 20px 24px;
		border-bottom: 1px solid var(--rule);
		font-size: var(--text-16);
		line-height: 1.6;
		color: var(--muted);
	}
	.keyboard-heading {
		margin: 64px 0 0;
		font-size: var(--text-21);
		line-height: 1.5;
	}
	.keyboard-intro {
		margin: 8px 0 20px;
		font-size: var(--text-16);
		line-height: 1.5;
		color: var(--muted);
	}
	.shortcuts {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.shortcut {
		display: flex;
		align-items: center;
		gap: 16px;
		padding: 12px 0;
		border-top: 1px solid var(--rule);
	}
	.shortcut-keys {
		display: flex;
		flex: 0 0 150px;
		align-items: center;
		gap: 6px;
	}
	.shortcut-joiner {
		font-size: var(--text-12);
		color: var(--soft);
	}
	.shortcut-label {
		font-size: var(--text-16);
		line-height: 1.5;
		color: var(--muted);
	}

	@media (max-width: 767px) {
		.colophon {
			padding: 40px 0 56px;
		}
		.colophon-title {
			letter-spacing: -0.026em;
		}
		.colophon-dek {
			margin-top: 12px;
			font-size: var(--text-18);
			line-height: 1.55;
		}
		.colophon-rows {
			display: block;
			margin-top: 28px;
		}
		.colophon-row {
			display: block;
			padding: 16px 0;
			border-bottom: 1px solid var(--rule);
		}
		.colophon-rows dt,
		.colophon-rows dd {
			padding: 0;
			border-bottom: 0;
		}
		.colophon-rows dt {
			font-size: var(--text-14);
		}
		.colophon-rows dd {
			margin-top: 6px;
		}
		.keyboard {
			display: none;
		}
	}
</style>
