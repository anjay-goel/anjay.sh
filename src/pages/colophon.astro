---
import { getEntry, render } from "astro:content";
import ColophonKeyboard from "@/components/colophon/ColophonKeyboard.astro";
import ColophonLink from "@/components/colophon/ColophonLink.astro";
import ColophonRows from "@/components/colophon/ColophonRows.astro";
import DesktopOnly from "@/components/colophon/DesktopOnly.astro";
import Specimen from "@/components/colophon/Specimen.astro";
import Swatch from "@/components/colophon/Swatch.astro";
import Swatches from "@/components/colophon/Swatches.astro";
import ShortcutKeys from "@/components/shortcuts/ShortcutKeys.astro";
import PageLayout from "@/layouts/Base.astro";

const entry = await getEntry("page", "colophon");
if (!entry) throw new Error("Missing src/content/page/colophon.mdx");
const { Content } = await render(entry);
const { title, description, dek } = entry.data;

const components = {
	a: ColophonLink,
	DesktopOnly,
	Keyboard: ColophonKeyboard,
	Rows: ColophonRows,
	Shortcut: ShortcutKeys,
	Specimen,
	Swatch,
	Swatches,
};
---

<PageLayout meta={{ title, description }}>
	<section class="colophon">
		<h1 class="page-title colophon-title">{title}</h1>
		{dek && <p class="colophon-dek">{dek}</p>}
		<Content components={components} />
	</section>
</PageLayout>

<style>
	.colophon {
		max-width: 820px;
		padding: 80px 0 120px;
	}
	.colophon-title {
		line-height: 1.02;
		letter-spacing: -0.028em;
	}
	.colophon-dek {
		margin: 20px 0 0;
		font-family: var(--font-serif);
		font-size: var(--text-21);
		line-height: 1.6;
		color: var(--muted);
	}

	@media (max-width: 767px) {
		.colophon {
			padding: 40px 0 56px;
		}
		.colophon-title {
			letter-spacing: -0.026em;
		}
		.colophon-dek {
			margin-top: 12px;
			font-size: var(--text-18);
			line-height: 1.55;
		}
	}
</style>
