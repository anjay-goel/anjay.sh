---
import PostMeta from "@/components/ui/PostMeta.astro";
import { metaCopy } from "@/content/copy/meta";
import { notFoundCopy as copy } from "@/content/copy/notfound";
import { getPostSummaries } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { withBase } from "@/utils/path";

const meta = {
	description: copy.metaDescription,
	title: copy.metaTitle,
	noindex: true,
};

const recent = (await getPostSummaries()).slice(0, copy.recentCount);
---

<PageLayout meta={meta} navCurrent={null}>
	<section class="not-found">
		<p class="nf-prompt"><span class="nf-dollar">{copy.prompt}</span> {copy.command}</p>
		<p class="nf-numeral" aria-hidden="true">{copy.numeral}<span class="nf-cursor"></span></p>
		<h1 class="nf-heading">{copy.heading}</h1>
		<p class="nf-body">{copy.body}</p>
		<nav class="nf-links" aria-label={copy.linksLabel}>
			{copy.links.map((l) => <a class="link link-solid nf-link" href={withBase(l.href)}>{l.text}</a>)}
		</nav>
		<h2 class="nf-recent-heading">{copy.recentHeading}</h2>
		<ul class="nf-recent">
			{
				recent.map((post) => (
					<li>
						<a class="nf-post" href={post.href} data-post-row>
							<PostMeta date={post.date} parts={post.label ? [post.label.text] : []} />
							<span class="nf-post-title">
								{post.title}
								{post.external && <span class="sr-only">{metaCopy.externalSr}</span>}
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</PageLayout>

<style>
	.not-found {
		max-width: 640px;
		padding: 112px 0 120px;
	}
	.nf-prompt {
		margin: 0;
		font-family: var(--font-mono);
		font-size: var(--text-16);
		line-height: 1.3;
		color: var(--soft);
	}
	.nf-dollar {
		color: var(--ok);
	}
	.nf-numeral {
		display: flex;
		align-items: flex-end;
		margin: 14px 0 0;
		font-family: var(--font-mono);
		font-size: 176px;
		font-weight: 500;
		line-height: 0.9;
		letter-spacing: -0.04em;
		color: var(--ink);
	}
	.nf-cursor {
		display: inline-block;
		flex: none;
		width: 58px;
		height: 128px;
		margin: 0 0 12px 14px;
		background: var(--accent);
	}
	.nf-heading {
		margin: 32px 0 0;
		font-size: var(--text-34);
		line-height: 1.15;
		letter-spacing: -0.015em;
	}
	.nf-body {
		margin: 14px 0 0;
		font-family: var(--font-serif);
		font-size: var(--text-18);
		line-height: 1.65;
		color: var(--muted);
	}
	.nf-links {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 24px;
		margin-top: 24px;
		font-size: var(--text-16);
	}
	.nf-link {
		display: inline-flex;
		align-items: center;
		height: 44px;
	}
	.nf-recent-heading {
		margin: 48px 0 8px;
		font-size: var(--text-14);
		font-weight: 400;
		line-height: 1.3;
		color: var(--soft);
	}
	.nf-recent {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.nf-post {
		display: block;
		padding: 10px 0;
		scroll-margin-block: 96px;
	}
	.nf-post :global(.post-meta) {
		line-height: 1.3;
	}
	.nf-post-title {
		display: block;
		margin-top: 4px;
		font-size: var(--text-18);
		font-weight: 500;
		line-height: 1.35;
		color: var(--ink);
		transition: color var(--dur) var(--ease);
	}
	.nf-post:hover .nf-post-title {
		color: var(--accent);
	}
	.nf-post:focus-visible {
		outline-offset: 8px;
		border-radius: var(--radius-md);
	}

	@media (max-width: 767px) {
		.not-found {
			padding: 48px 0 64px;
		}
		.nf-prompt {
			font-size: var(--text-14);
		}
		.nf-numeral {
			margin-top: 12px;
			font-size: 104px;
		}
		.nf-cursor {
			width: 34px;
			height: 76px;
			margin: 0 0 7px 8px;
		}
		.nf-heading {
			margin-top: 28px;
			font-size: var(--text-26);
		}
		.nf-recent-heading {
			margin-top: 32px;
		}
	}
</style>
