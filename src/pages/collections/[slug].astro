---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import type { GetStaticPaths } from "astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PostList from "@/components/blog/PostList.astro";
import { collectionsCopy } from "@/content/copy/collections";
import { type CollectionDoc, getCollections, orderCollectionPosts } from "@/data/collections";
import { getAllPosts, getPostHref } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";

export const getStaticPaths = (async () => {
	const collections = await getCollections();
	const posts = await getAllPosts();
	return collections.map((collection) => ({
		params: { slug: collection.id },
		props: { collection, posts: orderCollectionPosts(collection, posts) },
	}));
}) satisfies GetStaticPaths;

interface Props {
	collection: CollectionDoc;
	posts: CollectionEntry<"post">[];
}

const { collection, posts } = Astro.props;
const { Content } = await render(collection);
const hasIntro = Boolean(collection.body?.trim());
const startHref = collection.data.kind === "series" && posts[0] ? getPostHref(posts[0]) : undefined;

const meta = {
	description: collection.data.description,
	title: collection.data.title,
};
---

<PageLayout meta={meta}>
	<section class="collection" aria-labelledby="collection-title">
		<Breadcrumbs
			items={[{ label: collectionsCopy.crumb, href: "/posts/" }, { label: collection.data.title }]}
		/>
		<header class="page-head">
			<h1 class="page-title" id="collection-title">{collection.data.title}</h1>
			<p class="collection-desc">{collection.data.description}</p>
			{
				hasIntro && (
					<div class="collection-intro">
						<Content />
					</div>
				)
			}
			{
				startHref && (
					<a class="collection-start link--accent" data-astro-prefetch href={startHref}>
						{collection.data.cta ?? collection.data.title} →
					</a>
				)
			}
		</header>
		<div class="timeline">
			<PostList posts={posts} />
		</div>
	</section>
</PageLayout>

<style>
	.collection {
		margin-bottom: 96px;
	}
	.collection-desc {
		margin: 16px 0 0;
		font-size: var(--text-body);
		line-height: 1.62;
		color: hsl(var(--theme-text-muted));
	}
	.collection-intro {
		max-width: var(--reading-width);
		margin-top: 16px;
		font-size: var(--text-body);
		line-height: 1.65;
		color: hsl(var(--theme-text));
	}
	.collection-intro :global(p) {
		margin: 0 0 12px;
	}
	.collection-start {
		display: inline-block;
		margin-top: 8px;
		padding: 6px 0;
		font-size: var(--text-small);
	}

	@media (max-width: 420px) {
		.collection {
			margin-bottom: 64px;
		}
	}
</style>
