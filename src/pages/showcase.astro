---
import { showcase } from "@/data/showcase";
import PageLayout from "@/layouts/Base.astro";
import { absoluteUrl, withBase } from "@/utils/path";
import { Schema } from "astro-seo-schema";

const siteUrl = (path: string) => absoluteUrl(path, Astro.site);
---

<PageLayout meta={{ title: "Showcase" }}>
	<Schema
		slot="head"
		item={{
			"@context": "https://schema.org",
			"@type": "BreadcrumbList",
			itemListElement: [
				{
					"@type": "ListItem",
					position: 1,
					name: "Home",
					item: siteUrl("/"),
				},
				{
					"@type": "ListItem",
					position: 2,
					name: "Showcase",
					item: siteUrl("/showcase"),
				},
			],
		}}
	/>
	<section class="work" aria-labelledby="work-title">
		<header class="page-head">
			<h1 class="page-title" id="work-title">Showcase</h1>
		</header>
		<ul class="work-list">
			{
				showcase.map((item) => (
					<li>
						<a href={item.href} rel="noreferrer" target="_blank">
							<div class="head">
								<span class="name">{item.icon && <img class="name-icon" src={withBase(item.icon)} alt="" width="18" height="18" />}{item.name}</span>
								<span class="stack">{item.stack}</span>
								{item.badge && <span class="badge">{item.badge}</span>}
							</div>
							<p>{item.desc}</p>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</PageLayout>

<style>
	.work {
		margin-bottom: 88px;
	}
	@media (max-width: 420px) {
		.work {
			margin-bottom: 56px;
		}
	}
</style>
