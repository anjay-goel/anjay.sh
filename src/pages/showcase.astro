---
import FrameoPipeline from "@/components/art/FrameoPipeline.astro";
import JsonLd from "@/components/JsonLd.astro";
import Icon from "@/components/ui/Icon.astro";
import Card from "@/components/ui/Card.astro";
import { metaCopy } from "@/content/copy/meta";
import { showcaseCopy as copy } from "@/content/copy/showcase";
import { featuredProject, showcase, showcaseBadge } from "@/data/showcase";
import PageLayout from "@/layouts/Base.astro";
import { absoluteUrl } from "@/utils/path";

const siteUrl = (path: string) => absoluteUrl(path, Astro.site);
---

<PageLayout meta={{ title: copy.title, description: copy.description }}>
	<JsonLd
		slot="head"
		item={{
			"@context": "https://schema.org",
			"@type": "BreadcrumbList",
			itemListElement: [
				{
					"@type": "ListItem",
					position: 1,
					name: copy.breadcrumbHome,
					item: siteUrl("/"),
				},
				{
					"@type": "ListItem",
					position: 2,
					name: copy.title,
					item: siteUrl("/showcase/"),
				},
			],
		}}
	/>
	<h1 class="page-title showcase-title">{copy.title}</h1>
	<Card href={featuredProject.href} class="featured" target="_blank" rel="noreferrer">
		<div class="featured-text">
			<span class="featured-status">{copy.featuredStatus}</span>
			<span class="card-title featured-name">{featuredProject.name}</span>
			<span class="featured-desc">{featuredProject.desc}</span>
			<span class="featured-link">{featuredProject.linkText}<Icon name="arrowUpRight" size={13} strokeWidth={2} /><span class="sr-only">{metaCopy.newTabSr}</span></span>
		</div>
		<div class="featured-art">
			<FrameoPipeline />
		</div>
	</Card>
	<ul class="projects">
		{
			showcase.map((item) => (
				<li class="project-item">
					<Card href={item.href} class="project" target="_blank" rel="noreferrer">
						<span class="card-title project-name">{item.name}</span>
						<span class="meta project-meta">
							<span>{item.stack}</span>
							{showcaseBadge(item) && <span class:list={[item.highlight && "project-badge-accent"]}>{showcaseBadge(item)}</span>}
						</span>
						<span class="project-desc">{item.desc}</span>
						<span class="project-link">{copy.sources[item.source]}<Icon name="arrowUpRight" size={12} strokeWidth={2} /><span class="sr-only">{metaCopy.newTabSr}</span></span>
					</Card>
				</li>
			))
		}
	</ul>
</PageLayout>

<style>
	.showcase-title {
		padding: 5rem 0 2.5rem;
	}
	.showcase-title,
	.featured-name,
	.project-name {
		overflow-wrap: anywhere;
	}
	a.featured {
		flex-direction: row;
		flex-wrap: wrap;
		align-items: center;
		gap: 2rem;
		margin-bottom: 1.25rem;
		padding: 1.875rem 2rem;
	}
	.featured-text {
		display: flex;
		flex: 1 1 22.5rem;
		flex-direction: column;
		align-items: flex-start;
		min-width: 0;
	}
	.featured-status {
		font-size: var(--text-12);
		line-height: normal;
		color: var(--ok);
	}
	.featured-name {
		display: block;
		margin-top: 0.875rem;
		font-size: var(--text-44);
		font-weight: 600;
		line-height: 1;
		letter-spacing: -0.025em;
	}
	.featured-desc {
		display: block;
		max-width: 30em;
		margin-top: 0.625rem;
		font-size: var(--text-16);
		line-height: 1.55;
		color: var(--muted);
	}
	.featured-link {
		display: flex;
		align-items: center;
		gap: 0.25em;
		margin-top: 1rem;
		font-size: var(--text-14);
		line-height: normal;
		color: var(--accent);
	}
	.featured-link :global(svg),
	.project-link :global(svg) {
		flex: none;
		width: 0.85em;
		height: 0.85em;
	}
	.featured-art {
		flex: 1 1 26.25rem;
		min-width: 0;
		height: 9.375rem;
		box-sizing: border-box;
		border: 1px solid var(--rule);
		border-radius: var(--radius-xl);
		background: var(--panel);
		overflow: hidden;
	}
	.projects {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.25rem;
		margin: 0;
		padding: 0 0 7.5rem;
		list-style: none;
	}
	.project-item {
		display: flex;
		min-width: 0;
	}
	.projects .project {
		flex: 1;
		padding: 1.625rem 1.5rem;
	}
	.project-name {
		font-size: var(--text-34);
		font-weight: 600;
		line-height: 1.05;
		letter-spacing: -0.02em;
	}
	.project-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.875rem;
		margin-top: 0.625rem;
	}
	.project-badge-accent {
		color: var(--accent);
	}
	.project-desc {
		margin-top: 1rem;
		font-size: var(--text-16);
		line-height: 1.6;
		color: var(--muted);
	}
	.project-link {
		display: flex;
		align-items: center;
		gap: 0.25em;
		margin-top: auto;
		padding-top: 1.375rem;
		font-size: var(--text-14);
		line-height: normal;
		color: var(--accent);
	}

	@media (min-width: 768px) and (max-width: 1023px) {
		.featured-text {
			flex-basis: 18rem;
		}
		.featured-art {
			flex-basis: 20rem;
		}
	}

	@media (max-width: 767px) {
		.showcase-title {
			padding: 2.5rem 0 1.5rem;
		}
		.projects {
			grid-template-columns: minmax(0, 1fr);
		}
		a.featured {
			flex-direction: column;
			flex-wrap: nowrap;
			align-items: stretch;
			gap: 0;
			margin-bottom: 0.75rem;
			padding: 1.625rem 1.5rem;
		}
		.featured-text {
			display: contents;
		}
		.featured-status {
			order: 0;
		}
		.featured-art {
			order: 1;
			flex: none;
			height: 6rem;
			margin-top: 0.875rem;
			border-radius: var(--radius-lg);
		}
		.featured-name {
			order: 2;
			font-size: var(--text-26);
			letter-spacing: 0;
		}
		.featured-desc {
			order: 3;
			margin-top: 0.375rem;
			font-size: var(--text-16);
			line-height: 1.45;
		}
		.featured-link {
			display: none;
		}
		.projects {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.75rem;
			padding-bottom: 3.5rem;
		}
		.projects .project {
			border-radius: var(--radius-xl);
		}
		.project-name {
			font-size: var(--text-21);
			line-height: 1.1;
			letter-spacing: -0.015em;
		}
		.project-meta {
			gap: 0.25rem 0.75rem;
			margin-top: 0.5rem;
		}
		.project-desc {
			margin-top: 0.75rem;
			line-height: 1.55;
		}
		.project-link {
			margin-top: 0.875rem;
			padding-top: 0;
		}
	}
</style>
