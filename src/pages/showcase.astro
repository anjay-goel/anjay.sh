---
import FrameoPipeline from "@/components/art/FrameoPipeline.astro";
import JsonLd from "@/components/JsonLd.astro";
import ArrowUpRight from "@/components/ui/ArrowUpRight.astro";
import Card from "@/components/ui/Card.astro";
import { showcaseCopy as copy } from "@/content/copy/showcase";
import { featuredProject, showcase, showcaseBadge } from "@/data/showcase";
import PageLayout from "@/layouts/Base.astro";
import { absoluteUrl } from "@/utils/path";

const siteUrl = (path: string) => absoluteUrl(path, Astro.site);
---

<PageLayout meta={{ title: copy.title, description: copy.description }}>
	<JsonLd
		slot="head"
		item={{
			"@context": "https://schema.org",
			"@type": "BreadcrumbList",
			itemListElement: [
				{
					"@type": "ListItem",
					position: 1,
					name: copy.breadcrumbHome,
					item: siteUrl("/"),
				},
				{
					"@type": "ListItem",
					position: 2,
					name: copy.title,
					item: siteUrl("/showcase"),
				},
			],
		}}
	/>
	<h1 class="page-title showcase-title">{copy.title}</h1>
	<Card href={featuredProject.href} padding="none" class="featured" target="_blank" rel="noreferrer">
		<div class="featured-text">
			<span class="featured-status">{copy.featuredStatus}</span>
			<span class="card-title featured-name">{featuredProject.name}</span>
			<span class="featured-desc">{featuredProject.desc}</span>
			<span class="featured-link">{featuredProject.linkText}<ArrowUpRight /><span class="sr-only">{copy.externalSr}</span></span>
		</div>
		<div class="featured-art">
			<FrameoPipeline />
		</div>
	</Card>
	<ul class="projects">
		{
			showcase.map((item) => (
				<li class="project-item">
					<Card href={item.href} padding="none" class="project" target="_blank" rel="noreferrer">
						<span class="card-title project-name">{item.name}</span>
						<span class="meta project-meta">
							<span>{item.stack}</span>
							{showcaseBadge(item) && <span class:list={[item.highlight && "project-badge-accent"]}>{showcaseBadge(item)}</span>}
						</span>
						<span class="project-desc">{item.desc}</span>
						<span class="project-link">
							{copy.sources[item.source]}
							<ArrowUpRight size={12} />
							<span class="sr-only">{copy.externalSr}</span>
						</span>
					</Card>
				</li>
			))
		}
	</ul>
</PageLayout>

<style>
	.showcase-title {
		padding: 80px 0 40px;
	}
	.showcase-title,
	.featured-name,
	.project-name {
		overflow-wrap: anywhere;
	}
	a.featured {
		flex-direction: row;
		flex-wrap: wrap;
		align-items: center;
		gap: 32px;
		margin-bottom: 20px;
		padding: 30px 32px;
	}
	.featured-text {
		display: flex;
		flex: 1 1 360px;
		flex-direction: column;
		align-items: flex-start;
		min-width: 0;
	}
	.featured-status {
		font-size: var(--text-12);
		line-height: normal;
		color: var(--ok);
	}
	.featured-name {
		display: block;
		margin-top: 14px;
		font-size: var(--text-44);
		font-weight: 600;
		line-height: 1;
		letter-spacing: -0.025em;
	}
	.featured-desc {
		display: block;
		max-width: 30em;
		margin-top: 10px;
		font-size: var(--text-16);
		line-height: 1.55;
		color: var(--muted);
	}
	.featured-link {
		display: flex;
		align-items: center;
		gap: 6px;
		margin-top: 16px;
		font-size: var(--text-14);
		line-height: normal;
		color: var(--accent);
	}
	.featured-art {
		flex: 1 1 420px;
		min-width: 0;
		height: 150px;
		box-sizing: border-box;
		border: 1px solid var(--rule);
		border-radius: var(--radius-xl);
		background: var(--panel);
		overflow: hidden;
	}
	.projects {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr));
		gap: 20px;
		margin: 0;
		padding: 0 0 112px;
		list-style: none;
	}
	.project-item {
		display: flex;
		min-width: 0;
	}
	.projects .project {
		flex: 1;
		padding: 26px 24px;
	}
	.project-name {
		font-size: var(--text-34);
		font-weight: 600;
		line-height: 1.05;
		letter-spacing: -0.02em;
	}
	.project-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 14px;
		margin-top: 10px;
	}
	.project-badge-accent {
		color: var(--accent);
	}
	.project-desc {
		margin-top: 16px;
		font-size: var(--text-16);
		line-height: 1.6;
		color: var(--muted);
	}
	.project-link {
		display: flex;
		align-items: center;
		gap: 4px;
		margin-top: auto;
		padding-top: 22px;
		font-size: var(--text-14);
		line-height: normal;
		color: var(--accent);
	}

	@media (max-width: 767px) {
		.showcase-title {
			padding: 40px 0 24px;
		}
		a.featured {
			flex-direction: column;
			flex-wrap: nowrap;
			align-items: stretch;
			gap: 0;
			margin-bottom: 12px;
			padding: 18px 16px;
		}
		.featured-text {
			display: contents;
		}
		.featured-status {
			order: 0;
		}
		.featured-art {
			order: 1;
			flex: none;
			height: 96px;
			margin-top: 14px;
			border-radius: var(--radius-lg);
		}
		.featured-name {
			order: 2;
			font-size: var(--text-26);
			letter-spacing: 0;
		}
		.featured-desc {
			order: 3;
			margin-top: 6px;
			font-size: var(--text-14);
			line-height: 1.45;
		}
		.featured-link {
			display: none;
		}
		.projects {
			grid-template-columns: minmax(0, 1fr);
			gap: 12px;
			padding-bottom: 48px;
		}
		.projects .project {
			border-radius: var(--radius-xl);
		}
		.project-name {
			font-size: var(--text-26);
			line-height: 1.1;
			letter-spacing: -0.015em;
		}
		.project-meta {
			gap: 4px 12px;
			margin-top: 8px;
		}
		.project-desc {
			margin-top: 12px;
			line-height: 1.55;
		}
		.project-link {
			margin-top: 14px;
			padding-top: 0;
		}
	}
</style>
