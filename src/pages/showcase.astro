---
import ShowcaseList from "@/components/ShowcaseList.astro";
import { showcase } from "@/data/showcase";
import PageLayout from "@/layouts/Base.astro";
import { absoluteUrl } from "@/utils/path";
import { Schema } from "astro-seo-schema";

const siteUrl = (path: string) => absoluteUrl(path, Astro.site);
---

<PageLayout meta={{ title: "Showcase" }}>
	<Schema
		slot="head"
		item={{
			"@context": "https://schema.org",
			"@type": "BreadcrumbList",
			itemListElement: [
				{
					"@type": "ListItem",
					position: 1,
					name: "Home",
					item: siteUrl("/"),
				},
				{
					"@type": "ListItem",
					position: 2,
					name: "Showcase",
					item: siteUrl("/showcase"),
				},
			],
		}}
	/>
	<section class="showcase" aria-labelledby="showcase-title">
		<header class="page-head">
			<h1 class="page-title" id="showcase-title">Showcase</h1>
		</header>
		<ShowcaseList items={showcase} />
	</section>
</PageLayout>

<style>
	.showcase {
		margin-bottom: 88px;
	}
	@media (max-width: 420px) {
		.showcase {
			margin-bottom: 56px;
		}
	}
</style>
