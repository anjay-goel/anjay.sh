---
import PostList from "@/components/blog/PostList.astro";
import Collections from "@/components/home/Collections.astro";
import ShowcaseList from "@/components/ShowcaseList.astro";
import Socials from "@/components/Socials.astro";
import { getCollections } from "@/data/collections";
import { getSortedPosts } from "@/data/post";
import { showcase } from "@/data/showcase";
import PageLayout from "@/layouts/Base.astro";
import { siteConfig } from "@/site-config";
import { absoluteUrl } from "@/utils/path";
import { Icon } from "astro-icon/components";
import { Schema } from "astro-seo-schema";

const allPosts = await getSortedPosts();
const TIMELINE_LIMIT = 5;
const timelinePosts = allPosts.slice(0, TIMELINE_LIMIT);
const archiveCount = allPosts.length;
const collections = await getCollections();

const siteUrl = (path: string) => absoluteUrl(path, Astro.site);
---

<PageLayout meta={{ title: "Home", description: siteConfig.description }}>
	<Schema
		slot="head"
		item={{
			"@context": "https://schema.org",
			"@type": "BreadcrumbList",
			itemListElement: [
				{
					"@type": "ListItem",
					position: 1,
					name: "Home",
					item: siteUrl("/"),
				},
				{
					"@type": "ListItem",
					position: 2,
					name: "About",
					item: siteUrl("/about"),
				},
				{
					"@type": "ListItem",
					position: 3,
					name: "Posts",
					item: siteUrl("/posts"),
				},
			],
		}}
	/>
	<h1 class="sr-only">{siteConfig.title}</h1>
	<section class="hero">
		<p>{siteConfig.description}</p>
		<Socials />
	</section>

	<section class="writing" aria-labelledby="writing-label">
		<div class="section-label" id="writing-label">Writing</div>
		<div class="timeline">
			<PostList posts={timelinePosts} />

			<a class="entry archive" data-astro-prefetch href="/posts/" style={`--i: ${timelinePosts.length}`}>
				<div class="entry-rail">
					<span class="entry-date">Archive</span>
					<span class="entry-dot" aria-hidden="true" />
				</div>
				<div class="entry-body">
					<span class="entry-title">
						All {archiveCount} posts<span class="archive-arrow"><Icon name="tabler:arrow-right" aria-hidden="true" /></span>
					</span>
				</div>
			</a>
		</div>
	</section>

	<Collections collections={collections} />

	{showcase.length > 0 && (
		<section class="showcase" aria-labelledby="showcase-label">
			<div class="section-label" id="showcase-label">Showcase</div>
			<ShowcaseList items={showcase} clamp />
		</section>
	)}
</PageLayout>

<style>
	/* ---------- Hero ---------- */
	.hero {
		margin-bottom: 64px;
		font-size: var(--text-body);
	}
	.hero p {
		line-height: 1.65;
		color: hsl(var(--theme-text));
		margin: 0 0 16px;
		text-wrap: pretty;
	}

	/* ---------- Writing timeline ---------- */
	.writing {
		margin-bottom: 84px;
	}
	.entry.archive {
		--entry-gap: 0px;
	}
	.entry.archive .entry-title {
		display: block;
		margin: 0;
	}
	.archive-arrow {
		display: inline-block;
		margin-left: 0.3em;
		vertical-align: -0.16em;
	}
	.archive-arrow :global(svg) {
		display: block;
		width: 1em;
		height: 1em;
	}

	.showcase {
		margin-bottom: 88px;
	}

	@media (max-width: 720px) {
		.hero {
			margin-bottom: 56px;
		}
		.entry.archive {
			padding-bottom: 0;
		}
	}

	@media (max-width: 420px) {
		.hero {
			margin-bottom: 48px;
		}
		.writing {
			margin-bottom: 64px;
		}
	}
</style>
