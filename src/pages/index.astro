---
import HomeArchive from "@/components/home/HomeArchive.astro";
import HomeCollections from "@/components/home/HomeCollections.astro";
import HomeHero from "@/components/home/HomeHero.astro";
import HomeLatest from "@/components/home/HomeLatest.astro";
import HomeShipped from "@/components/home/HomeShipped.astro";
import JsonLd from "@/components/JsonLd.astro";
import { homeCopy } from "@/content/copy/home";
import { getCollections } from "@/data/collections";
import { getAllPosts, getPostSummaries, getPostYears } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { siteConfig } from "@/site-config";
import { absoluteUrl } from "@/utils/path";

const RECENT_COUNT = 3;

const posts = await getAllPosts();
const summaries = await getPostSummaries(posts);
const collections = await getCollections();
const years = getPostYears(posts);
const [featured, ...rest] = summaries;
const recent = rest.slice(0, RECENT_COUNT);

const siteUrl = (path: string) => absoluteUrl(path, Astro.site);
---

<PageLayout meta={{ title: homeCopy.meta.title, description: siteConfig.description }} footer="home">
	<JsonLd
		slot="head"
		item={{
			"@context": "https://schema.org",
			"@type": "WebSite",
			name: siteConfig.title,
			url: siteUrl("/"),
			description: siteConfig.description,
			inLanguage: siteConfig.lang,
			author: {
				"@type": "Person",
				name: siteConfig.author,
				url: siteUrl("/about/"),
			},
		}}
	/>
	<HomeHero />
	{featured && <HomeLatest featured={featured} recent={recent} total={summaries.length} />}
	<HomeCollections collections={collections} posts={summaries} />
	<HomeArchive years={years} />
	<HomeShipped />
</PageLayout>
