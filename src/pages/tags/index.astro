---
import ArchiveHero from "@/components/posts/ArchiveHero.astro";
import TagIndex from "@/components/posts/TagIndex.astro";
import { metaCopy } from "@/content/copy/meta";
import { postsCopy } from "@/content/copy/posts";
import { getAllPosts, getUniqueTagsWithCount } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { withBase } from "@/utils/path";

const posts = await getAllPosts();
const tags = getUniqueTagsWithCount(posts);

const meta = {
	title: postsCopy.tags.metaTitle,
	description: postsCopy.tags.description,
};
---

<PageLayout meta={meta}>
	<ArchiveHero title={postsCopy.tags.title}>
		{postsCopy.tags.summary(tags.length, posts.length)}{metaCopy.separator}<a
			class="link link-solid"
			href={withBase("/posts/")}
			data-astro-prefetch>{postsCopy.tags.allPosts}</a
		>
	</ArchiveHero>
	<TagIndex tags={tags} />
</PageLayout>
