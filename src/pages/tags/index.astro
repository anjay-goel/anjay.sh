---
import { getAllPosts, getTagHref, getUniqueTagsWithCount } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";

const tags = getUniqueTagsWithCount(await getAllPosts());

const meta = {
	description: "Browse every topic written about on this site.",
	title: "Tags",
};
---

<PageLayout meta={meta}>
	<section class="tags-index" aria-labelledby="tags-title">
		<header class="page-head">
			<h1 class="page-title" id="tags-title">Tags</h1>
			<p class="page-count">{tags.length} {tags.length === 1 ? "tag" : "tags"}</p>
		</header>
		<ul class="tag-run">
			{
				tags.map(([tag, count]) => (
					<li>
						<a class="hit-area" data-astro-prefetch href={getTagHref(tag)}>
							<span class="name">{tag}</span>
							<span class="count">{count}</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</PageLayout>

<style>
	.tags-index {
		margin-bottom: 96px;
	}

	.tag-run {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 12px 24px;
	}
	.tag-run a {
		--hit-inset: -5px -8px;
		display: inline-flex;
		align-items: baseline;
		gap: 5px;
		text-decoration: none;
		color: hsl(var(--theme-text));
		font-size: var(--text-small);
		letter-spacing: 0.01em;
		transition: color var(--fade-fast);
	}
	.tag-run .name::before {
		content: "#";
		color: var(--faint);
		transition: color var(--fade-fast);
	}
	.tag-run a:hover {
		color: hsl(var(--theme-accent));
	}
	.tag-run a:hover .name::before {
		color: hsl(var(--theme-accent));
	}
	.tag-run .count {
		font-size: var(--text-meta);
		color: hsl(var(--theme-text-muted));
		font-variant-numeric: tabular-nums;
	}
	.tag-run a:hover .count {
		color: hsl(var(--theme-accent) / 0.7);
	}

	@media (max-width: 420px) {
		.tags-index {
			margin-bottom: 64px;
		}
	}
</style>
