---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import ArchiveHero from "@/components/posts/ArchiveHero.astro";
import TagFilter from "@/components/posts/TagFilter.astro";
import YearArchive from "@/components/posts/YearArchive.astro";
import { metaCopy } from "@/content/copy/meta";
import { postsCopy } from "@/content/copy/posts";
import { getAllPosts, getPostSummaries, getPostsByTag, getUniqueTagsWithCount } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { withBase } from "@/utils/path";

export const getStaticPaths = (async () => {
	const posts = await getAllPosts();
	const tags = getUniqueTagsWithCount(posts).map(([tag]) => tag);
	return tags.map((tag) => ({
		params: { tag },
		props: { tag, tags, tagged: getPostsByTag(posts, tag) },
	}));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { tag, tags, tagged } = Astro.props;
const summaries = await getPostSummaries(tagged);

const meta = {
	title: postsCopy.tag.metaTitle(tag),
	description: postsCopy.tag.description(tag),
};
---

<PageLayout meta={meta}>
	<ArchiveHero title={postsCopy.tag.heading(tag)}>
		{postsCopy.tag.summary(summaries.length, tag)}{metaCopy.separator}<a
			class="link link-solid hit-target"
			href={withBase("/posts/")}
			data-astro-prefetch>{postsCopy.tag.allPosts}</a
		>
		<TagFilter slot="filter" tags={tags} current={tag} />
	</ArchiveHero>
	<YearArchive posts={summaries} />
</PageLayout>
