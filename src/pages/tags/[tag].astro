---
import type { CollectionEntry } from "astro:content";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PostList from "@/components/blog/PostList.astro";
import { getPostsByTag, getSortedPosts, getUniqueTags } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
	const posts = await getSortedPosts();
	return getUniqueTags(posts).map((tag) => ({
		params: { tag },
		props: { posts: getPostsByTag(posts, tag), tag },
	}));
}) satisfies GetStaticPaths;

interface Props {
	tag: string;
	posts: CollectionEntry<"post">[];
}

const { posts, tag } = Astro.props;
const count = posts.length;

const meta = {
	description: `Every post tagged “${tag}”.`,
	title: `Posts tagged #${tag}`,
};
---

<PageLayout meta={meta}>
	<section class="tag-archive" aria-labelledby="tag-title">
		<Breadcrumbs items={[{ label: "Tags", href: "/tags/" }, { label: `#${tag}` }]} />
		<header class="page-head">
			<h1 class="page-title" id="tag-title">#{tag}</h1>
			<p class="page-count">{count} {count === 1 ? "post" : "posts"}</p>
		</header>
		<div class="timeline">
			<PostList posts={posts} />
		</div>
	</section>
</PageLayout>

<style>
	.tag-archive {
		margin-bottom: 96px;
	}

	@media (max-width: 420px) {
		.tag-archive {
			margin-bottom: 64px;
		}
	}
</style>
