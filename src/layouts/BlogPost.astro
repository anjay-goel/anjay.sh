---
import "@/styles/article.css";
import type { MarkdownHeading } from "astro";
import katexStylesheet from "katex/dist/katex.min.css?url";
import ArticleHeader, { type HeaderMetaItem } from "@/components/article/ArticleHeader.astro";
import Icon from "@/components/ui/Icon.astro";
import Capabilities from "@/components/article/Capabilities.astro";
import Comments from "@/components/article/Comments.astro";
import PostPager, { type PagerLink } from "@/components/article/PostPager.astro";
import ReadingProgress from "@/components/article/ReadingProgress.astro";
import SeriesBar from "@/components/article/SeriesBar.astro";
import SeriesBox, { type SeriesItem } from "@/components/article/SeriesBox.astro";
import TocBar from "@/components/article/TocBar.astro";
import TocNav from "@/components/article/TocNav.astro";
import Mermaid from "@/components/blog/Mermaid.astro";
import JsonLd from "@/components/JsonLd.astro";
import { metaCopy } from "@/content/copy/meta";
import { postCopy } from "@/content/copy/post";
import { collectionHref, collectionPostIds } from "@/data/collections";
import { getAllPosts, getPostHref, type PostEntry, sortMDByDate, tagHref, toPostSummary } from "@/data/post";
import { genericTags, getPostExtras } from "@/data/post-extras";
import { siteConfig } from "@/site-config";
import { formatDayMonthYear } from "@/utils/date";
import { absoluteUrl, withBase } from "@/utils/path";
import { toRoman } from "@/utils/roman";
import { buildToc, countToc, MIN_TOC_ENTRIES } from "@/utils/toc";
import BaseLayout from "./Base.astro";

interface Props {
	post: PostEntry;
	headings: MarkdownHeading[];
	frontmatter: Record<string, unknown>;
}

const { post, headings, frontmatter } = Astro.props;
const { data, id } = post;
const { description, ogImage, publishDate, title, updatedDate, tags, draft } = data;

const summary = await toPostSummary(post);
const { collection, part } = summary;
const allPosts = sortMDByDate(await getAllPosts()).filter((p) => !p.data.externalUrl);
const byId = new Map(allPosts.map((p) => [p.id, p]));

const subtitle = (t: string) => {
	const i = t.indexOf(": ");
	return i >= 0 ? t.slice(i + 2) : t;
};

const seriesItems: SeriesItem[] =
	collection && part
		? collectionPostIds(collection).flatMap((pid, i) => {
				const entry = byId.get(pid);
				return entry ? [{ roman: toRoman(i + 1), title: subtitle(entry.data.title), href: getPostHref(entry), current: pid === id }] : [];
			})
		: [];

const MAX_META_LABELS = 3;
const toc = buildToc(headings);
const hasToc = countToc(toc) >= MIN_TOC_ENTRIES;
const layout = part || hasToc ? "rails" : "single";

const metaItems: HeaderMetaItem[] = [];
if (summary.minutes !== undefined) metaItems.push({ text: postCopy.readTime(summary.minutes) });
if (draft) metaItems.push({ text: postCopy.draft, accent: true });
if (updatedDate) metaItems.push({ text: postCopy.updated(formatDayMonthYear(updatedDate)), wide: true });
const metaTags = [summary.primaryTag, ...tags.filter((t) => t !== summary.primaryTag && !genericTags.includes(t))].filter(
	(t): t is string => Boolean(t),
);
const labels: HeaderMetaItem[] = [
	...(collection && !part ? [{ text: collection.data.label, href: collectionHref(collection) }] : []),
	...metaTags.map((tag) => ({ text: metaCopy.tag(tag), href: tagHref(tag) })),
].slice(0, MAX_META_LABELS);
metaItems.push(...labels.map((item, i) => ({ ...item, wide: i > 0 })));

const index = allPosts.findIndex((p) => p.id === id);
const older = index >= 0 ? allPosts[index + 1] : undefined;
const newer = index > 0 ? allPosts[index - 1] : undefined;
const seriesLink = (pid: string | undefined, label: string): PagerLink | undefined => {
	const entry = pid ? byId.get(pid) : undefined;
	const item = seriesItems.find((s) => s.href === (entry && getPostHref(entry)));
	return entry && item ? { label, title: postCopy.series.partTitle(item.roman, item.title), href: getPostHref(entry) } : undefined;
};
const plainLink = (entry: PostEntry | undefined, label: string): PagerLink | undefined =>
	entry ? { label, title: entry.data.title, href: getPostHref(entry) } : undefined;
const previous = seriesLink(part?.prevId, postCopy.pager.previousInSeries) ?? plainLink(older, postCopy.pager.previous);
const next = seriesLink(part?.nextId, postCopy.pager.nextInSeries) ?? plainLink(newer, postCopy.pager.next);

const { hasMath, hasMermaid, hasCapabilities } = frontmatter as {
	hasMath?: boolean;
	hasMermaid?: boolean;
	hasCapabilities?: boolean;
};

const authorName = siteConfig.profile?.name ?? siteConfig.author;
const socialImage = ogImage ?? `/og-image/${id}.png`;
const articleDate = publishDate.toISOString();
const articleModified = updatedDate?.toISOString();
const postUrl = absoluteUrl(`/posts/${id}/`, Astro.site);
---

<BaseLayout meta={{ articleDate, articleModified, description, ogImage: socialImage, title }} width="article" headerDense>
	{hasMath && <link rel="stylesheet" href={katexStylesheet} slot="head" />}
	{hasMermaid && <Mermaid slot="head" />}
	<JsonLd
		slot="head"
		item={{
			"@context": "https://schema.org",
			"@type": "BlogPosting",
			headline: title,
			datePublished: articleDate,
			dateModified: articleModified,
			url: postUrl,
			image: absoluteUrl(socialImage, Astro.site),
			author: { "@type": "Person", name: authorName },
			description,
		}}
	/>
	<ReadingProgress slot="before" />

	<a class="article-back" href={withBase("/posts/")}><Icon name="chevronLeft" />{postCopy.allPosts}</a>

	<div class="article-layout" data-layout={layout}>
		<article class="article" data-pagefind-body>
			<ArticleHeader
				title={title}
				description={description}
				date={publishDate}
				dateText={formatDayMonthYear(publishDate)}
				items={metaItems}
				filterTags={tags}
				author={authorName}
				authorNote={getPostExtras(id).authorNote}
			/>
			{
				layout === "rails" && (
					<div class="article-bars" data-pagefind-ignore>
						{collection && part && <SeriesBar title={collection.data.title} href={collectionHref(collection)} items={seriesItems} index={part.index} />}
						{hasToc && <TocBar items={toc} />}
					</div>
				)
			}
			<div class:list={["prose", part && "prose-series"]} data-article-body>
				<slot />
			</div>
			<PostPager previous={previous} next={next} />
			<Comments />
		</article>
		{
			layout === "rails" && (
				<aside class="article-rail">
					{collection && part && <SeriesBox title={collection.data.title} href={collectionHref(collection)} items={seriesItems} index={part.index} />}
					{hasToc && <TocNav items={toc} copyLink={Boolean(part)} class:list={["article-toc", part && "article-toc-series"]} />}
				</aside>
			)
		}
		{layout === "rails" && <div class="article-spacer" aria-hidden="true" />}
	</div>
	{hasCapabilities && <Capabilities />}
	<p class="sr-only" role="status" data-copy-status data-done={postCopy.toc.copiedStatus} data-failed={postCopy.toc.copyFailedStatus}></p>
</BaseLayout>

<style>
	.article-back {
		display: none;
	}
	.article-layout {
		display: flex;
		justify-content: center;
		gap: var(--rail-gap);
		padding: 3.5rem 0 7.5rem;
	}
	.article-rail {
		order: -1;
		flex: 1 1 12.5rem;
		max-width: var(--rail);
		min-width: 0;
	}
	.article {
		flex: 999 1 38.75rem;
		max-width: var(--article-col);
		min-width: 0;
	}
	.article-spacer {
		flex: 1 1 11.25rem;
		max-width: var(--rail);
		min-width: 0;
	}
	.article-rail :global(.article-toc) {
		position: sticky;
		top: 1.5rem;
		max-height: calc(100dvh - 3rem);
		margin-inline: -0.375rem;
		padding: 0 0.375rem 0.375rem;
		overflow-y: auto;
		scrollbar-width: thin;
	}
	.article-rail :global(.article-toc-series) {
		margin-top: 3rem;
	}
	.article-bars {
		display: none;
	}
	@media (max-width: 1279px) {
		.article-spacer {
			display: none;
		}
	}
	@media (max-width: 1023px) {
		.article-rail {
			display: none;
		}
		.article-bars {
			display: contents;
		}
	}
	@media (max-width: 767px) {
		.article-back {
			display: flex;
			align-items: center;
			gap: 0.375rem;
			width: fit-content;
			height: var(--tap);
			margin-top: 0.5rem;
			font-size: var(--text-14);
			color: var(--muted);
		}
		.article-back:hover {
			color: var(--accent);
		}
		.article-layout {
			padding: 0 0 3rem;
		}
	}
</style>

<script>
	import { initArticle } from "@/scripts/article";

	initArticle();
</script>
