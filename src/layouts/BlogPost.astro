---
import { type CollectionEntry, render } from "astro:content";
import { Image } from "astro:assets";
import Comments from "@/components/blog/Comments.astro";
import Mermaid from "@/components/blog/Mermaid.astro";
import PostHeader from "@/components/blog/PostHeader.astro";
import PostOutline from "@/components/blog/PostOutline.astro";
import PostPager from "@/components/blog/PostPager.astro";
import ShareButtons from "@/components/blog/ShareButtons.astro";
import { getCollections } from "@/data/collections";
import { getAdjacentPosts, getReadingTime } from "@/data/post";
import { authorName } from "@/site-config";
import { absoluteUrl } from "@/utils/path";
import { Schema } from "astro-seo-schema";
import katexStylesheet from "katex/dist/katex.min.css?url";
import BaseLayout from "./Base.astro";
import "../styles/prose.css";

interface Props {
	post: CollectionEntry<"post">;
}

const { post } = Astro.props;
const { coverImage, description, ogImage, publishDate, title, updatedDate } = post.data;

const { headings, remarkPluginFrontmatter } = await render(post);
const { hasMath, hasMermaid } = remarkPluginFrontmatter as {
	hasMath?: boolean;
	hasMermaid?: boolean;
};
const readingTime = await getReadingTime(post);
const { newer, older } = await getAdjacentPosts(post);
const parentCollection = (await getCollections()).find((collection) =>
	collection.data.posts.some((entry) => entry.id === post.id),
);

const socialImage = ogImage ?? `/og-image/${post.id}.png`;
const articleDate = publishDate.toISOString();
const articleModified = updatedDate?.toISOString();
const postUrl = absoluteUrl(`/posts/${post.id}/`, Astro.site);
---

<BaseLayout meta={{ articleDate, articleModified, description, ogImage: socialImage, title }}>
	{hasMath && <link rel="stylesheet" href={katexStylesheet} slot="head" />}
	{hasMermaid && <Mermaid slot="head" />}
	<Schema
		slot="head"
		item={{
			"@context": "https://schema.org",
			"@type": "BlogPosting",
			headline: title,
			datePublished: articleDate,
			dateModified: articleModified,
			url: postUrl,
			image: absoluteUrl(socialImage, Astro.site),
			author: {
				"@type": "Person",
				name: authorName,
			},
			description: description,
		}}
	/>
	<div class="post-main" data-pagefind-body>
		<PostHeader post={post} readingTime={readingTime} collection={parentCollection} />

		{coverImage ? (
			<figure class="post-cover">
				<Image
					src={coverImage.src}
					alt={coverImage.alt}
					loading="eager"
					fetchpriority="high"
					decoding="async"
					widths={[480, 720, 960, 1280]}
					sizes="(max-width: 720px) 92vw, 640px"
				/>
			</figure>
		) : (
			<hr class="rule" />
		)}

		<PostOutline headings={headings} />

		<article class="post-article">
			<slot />
		</article>

		<ShareButtons title={title} url={postUrl} description={description} />

		<hr class="rule rule--footer" />

		<PostPager older={older} newer={newer} />

		<Comments />
	</div>
</BaseLayout>

<style>
	.post-cover {
		margin: 0 0 36px;
		padding: 0;
	}
	.post-cover img {
		display: block;
		width: 100%;
		height: auto;
		max-height: 380px;
		object-fit: cover;
		border: 1px solid var(--hairline);
		border-radius: var(--radius-m);
		background: var(--paper);
	}

	.rule {
		height: 1px;
		background: var(--hairline);
		border: 0;
		margin: 0 0 44px;
		transition: background-color var(--fade-theme);
	}
	.rule--footer {
		margin: 56px 0 28px;
	}

	@media (max-width: 720px) {
		.rule { margin-bottom: 32px; }
	}
	@media (max-width: 420px) {
		.rule { margin-bottom: 26px; }
	}
</style>

<script>
	import "../scripts/post/lazy-images";
	import "../scripts/post/code-clip";
	import "../scripts/post/heading-anchors";
</script>
