{comments && (
	<script is:inline define:vars={{ comments, giscusThemes }}>
		document.addEventListener("DOMContentLoaded", () => {
			const mount = document.getElementById("comments");
			if (!mount) return;
			const theme = document.documentElement.getAttribute("data-theme");
			const script = document.createElement("script");
			script.src = "https://giscus.app/client.js";
			script.setAttribute("data-repo", comments.repo);
			script.setAttribute("data-repo-id", comments.repoId);
			script.setAttribute("data-category", comments.category);
			script.setAttribute("data-category-id", comments.categoryId);
			script.setAttribute("data-mapping", "title");
			script.setAttribute("data-strict", "0");
			script.setAttribute("data-reactions-enabled", "1");
			script.setAttribute("data-emit-metadata", "0");
			script.setAttribute("data-input-position", "top");
			script.setAttribute("data-theme", theme === "dark" ? giscusThemes.dark : giscusThemes.light);
			script.setAttribute("data-lang", "en");
			script.setAttribute("crossorigin", "anonymous");
			script.async = true;
			mount.appendChild(script);

			document.addEventListener("theme-change", (e) => {
				const iframe = document.querySelector("iframe.giscus-frame");
				if (iframe && iframe.contentWindow) {
					iframe.contentWindow.postMessage(
						{ giscus: { setConfig: { theme: e.detail.theme === "dark" ? giscusThemes.dark : giscusThemes.light } } },
						"https://giscus.app",
					);
				}
			});
		});
	</script>
)}
<script>
	const lazyImgs = document.querySelectorAll<HTMLImageElement>(
		'.post-article img[loading="lazy"]',
	);
	if (lazyImgs.length && "IntersectionObserver" in window) {
		const io = new IntersectionObserver(
			(entries) => {
				entries.forEach((e) => {
					if (e.isIntersecting) {
						(e.target as HTMLElement).dataset.in = "1";
						io.unobserve(e.target);
					}
				});
			},
			{ rootMargin: "120px 0px" },
		);
		lazyImgs.forEach((img) => io.observe(img));
	}

	const codeBlocks = document.querySelectorAll<HTMLPreElement>(".post-article .expressive-code pre");
	if (codeBlocks.length && "ResizeObserver" in window) {
		const markClipped = (pre: HTMLElement) =>
			pre.toggleAttribute("data-clipped", pre.scrollWidth - pre.clientWidth - pre.scrollLeft > 1);
		const ro = new ResizeObserver((entries) =>
			entries.forEach((e) => {
				const pre = e.target.closest("pre");
				const frame = pre?.offsetParent;
				if (!pre || !frame) return;
				const top = pre.getBoundingClientRect().top - frame.getBoundingClientRect().top + pre.clientTop;
				pre.style.setProperty("--clip-top", `${top}px`);
				markClipped(pre);
			}),
		);
		codeBlocks.forEach((pre) => {
			pre.addEventListener("scroll", () => markClipped(pre), { passive: true });
			ro.observe(pre);
			if (pre.firstElementChild) ro.observe(pre.firstElementChild);
		});
	}

	const slugify = (s: string) =>
		s.toLowerCase().trim().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
	const usedIds = new Set<string>();
	document
		.querySelectorAll<HTMLHeadingElement>(
			".post-article h1, .post-article h2, .post-article h3, .post-article h4, .post-article h5, .post-article h6",
		)
		.forEach((h) => {
			const baseId = h.id || slugify(h.textContent ?? "");
			if (!baseId) return;
			let id = baseId;
			for (let n = 2; usedIds.has(id); n++) id = `${baseId}-${n}`;
			usedIds.add(id);
			if (!h.id) h.id = id;

			const btn = document.createElement("button");
			btn.type = "button";
			btn.className = "heading-anchor";
			btn.setAttribute("aria-label", `Copy link to ${h.textContent ?? "section"}`);
			btn.textContent = "#";
			btn.addEventListener("click", async () => {
				const url = `${location.origin}${location.pathname}#${id}`;
				history.replaceState(null, "", `#${id}`);
				try {
					await navigator.clipboard.writeText(url);
					btn.textContent = "✓";
					setTimeout(() => (btn.textContent = "#"), 1200);
				} catch {}
			});
			h.prepend(btn);
		});
</script>
