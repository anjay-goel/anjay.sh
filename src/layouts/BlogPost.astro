---
import { type CollectionEntry, render } from "astro:content";
import { Image } from "astro:assets";

import ShareButtons from "@/components/blog/ShareButtons.astro";
import Mermaid from "@/components/blog/Mermaid.astro";
import PostOutline from "@/components/blog/PostOutline.astro";
import katexStylesheet from "katex/dist/katex.min.css?url";
import WebMentions from "@/components/blog/webmentions/index.astro";
import { collectionsCopy } from "@/content/copy/collections";
import { collectionHref, getCollections } from "@/data/collections";
import { getAllPosts, getPostHref, getPostSortDate, sortMDByDate } from "@/data/post";
import { siteConfig } from "@/site-config";
import { formatRailDate } from "@/utils/date";
import { absoluteUrl, withBase } from "@/utils/path";

import BaseLayout from "./Base.astro";
import { Schema } from "astro-seo-schema";

interface Props {
	post: CollectionEntry<"post">;
}

const { post } = Astro.props;

const sortedAll = sortMDByDate(await getAllPosts());
const idx = sortedAll.findIndex((p) => p.id === post.id);
const newerPost = idx > 0 ? sortedAll[idx - 1] : undefined;
const olderPost = idx >= 0 && idx < sortedAll.length - 1 ? sortedAll[idx + 1] : undefined;
const {
	data: { coverImage, description, ogImage, publishDate, title, updatedDate, tags, draft },
	id: slug,
} = post;
const socialImage = ogImage ?? `/og-image/${slug}.png`;
const articleDate = publishDate.toISOString();
const articleModified = updatedDate?.toISOString();
const { headings, remarkPluginFrontmatter } = await render(post);
const { hasMath, hasMermaid } = remarkPluginFrontmatter as { hasMath?: boolean; hasMermaid?: boolean };

const authorName = siteConfig.profile?.name ?? siteConfig.author;
const comments = siteConfig.comments;
const postUrl = absoluteUrl(`/posts/${slug}/`, Astro.site);
const socialImageAbsolute = absoluteUrl(socialImage, Astro.site);

const parentCollection = (await getCollections()).find((collection) =>
	collection.data.posts.some((entry) => entry.id === post.id),
);

// "2 May 2026"
const bylineDate = formatRailDate(publishDate);

// Prefer remark plugin's value; fall back to "".
const readingTime: string =
	(remarkPluginFrontmatter as { minutesRead?: string })?.minutesRead ?? "";

// Custom giscus themes only in prod: the giscus.app iframe can't fetch CSS from localhost / private IPs.
const giscusThemes = import.meta.env.PROD
	? {
			light: absoluteUrl("/giscus-light.css", Astro.site),
			dark: absoluteUrl("/giscus-dark.css", Astro.site),
		}
	: { light: "noborder_light", dark: "noborder_dark" };
---

<BaseLayout meta={{ articleDate, articleModified, description, ogImage: socialImage, title }}>
	{hasMath && <link rel="stylesheet" href={katexStylesheet} slot="head" />}
	{hasMermaid && <Mermaid slot="head" />}
	<Schema
		slot="head"
		item={{
			"@context": "https://schema.org",
			"@type": "BlogPosting",
			headline: title,
			datePublished: articleDate,
			dateModified: articleModified,
			url: postUrl,
			image: socialImageAbsolute,
			author: {
				"@type": "Person",
				name: authorName,
			},
			description: description,
		}}
	/>
	<div class="post-shell">
		<div class="post-main" data-pagefind-body>
			<div class="post-header">
				<nav class="crumbs" aria-label="Breadcrumb">
					<a data-astro-prefetch href={withBase("/posts/")}>{collectionsCopy.crumb}</a>
					{parentCollection && (
						<>
							<span class="sep" aria-hidden="true">/</span>
							<a data-astro-prefetch href={collectionHref(parentCollection)}>{parentCollection.data.title}</a>
						</>
					)}
				</nav>
				{draft && <span class="draft-flag">(Draft)</span>}
				<h1 class="post-title">{title}</h1>
				<p class="byline">
					{authorName && <>By {authorName}<span class="sep">·</span></>}{bylineDate}{readingTime && <><span class="sep">·</span>{readingTime}</>}
				</p>
				{!!tags?.length && (
					<div class="post-tags">
						{tags.map((tag) => (
							<a class="tag-link" data-pagefind-filter="tag" href={withBase(`/tags/${encodeURIComponent(tag)}/`)}>{tag}</a>
						))}
					</div>
				)}
				{updatedDate && (
					<div class="post-updated">
						Updated <time datetime={updatedDate.toISOString()}>
							{formatRailDate(updatedDate)}
						</time>
					</div>
				)}
			</div>

			{coverImage ? (
				<figure class="post-cover">
					<Image
						src={coverImage.src}
						alt={coverImage.alt}
						loading="eager"
						fetchpriority="high"
						decoding="async"
						widths={[480, 720, 960, 1280]}
						sizes="(max-width: 720px) 92vw, 640px"
					/>
				</figure>
			) : (
				<hr class="rule" />
			)}

			<PostOutline headings={headings} />

			<article class="post-article">
				<slot />
			</article>

			<ShareButtons title={title} url={postUrl} description={description} />

			<WebMentions />

			<hr class="rule rule--footer" />

			{(olderPost || newerPost) && (
				<nav class="post-pager" aria-label="More posts">
					{olderPost && (
						<a class="pager-link prev" data-astro-prefetch href={getPostHref(olderPost)}>
							<span class="pager-eyebrow">Older</span>
							<span class="pager-title">{olderPost.data.title}</span>
						</a>
					)}
					{newerPost && (
						<a class="pager-link next" data-astro-prefetch href={getPostHref(newerPost)}>
							<span class="pager-eyebrow">Newer</span>
							<span class="pager-title">{newerPost.data.title}</span>
						</a>
					)}
				</nav>
			)}

			{comments && <div class="comments" id="comments"></div>}
		</div>
	</div>
</BaseLayout>

<style>
	.post-shell { display: block; position: relative; }

	.post-cover {
		margin: 0 0 36px;
		padding: 0;
	}
	.post-cover img {
		display: block;
		width: 100%;
		height: auto;
		max-height: 380px;
		object-fit: cover;
		border: 1px solid var(--hairline);
		border-radius: 4px;
		background: var(--paper);
	}

	.crumbs {
		font-family: var(--font-sans);
		font-size: var(--text-meta);
		letter-spacing: 0.04em;
		color: hsl(var(--theme-text-muted));
		margin-bottom: 22px;
	}
	.crumbs a {
		position: relative;
		color: hsl(var(--theme-text-muted));
		text-decoration: underline;
		text-decoration-color: hsl(var(--theme-text) / 0.35);
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		transition: color 0.2s ease, text-decoration-color 0.2s ease;
	}
	.crumbs a::before {
		content: "";
		position: absolute;
		inset: -8px -6px;
	}
	.crumbs a:hover {
		color: hsl(var(--theme-accent));
		text-decoration-color: hsl(var(--theme-accent));
	}
	.crumbs a:focus-visible {
		outline: 2px solid hsl(var(--theme-accent));
		outline-offset: 3px;
		border-radius: 3px;
	}
	.crumbs .sep {
		color: var(--faint);
		margin: 0 8px;
	}

	.draft-flag {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: var(--text-meta);
		color: #c14a2b;
		margin-bottom: 12px;
		letter-spacing: 0.08em;
	}

	.post-title {
		font-family: var(--font-sans);
		font-weight: var(--title-weight-large);
		font-size: var(--title-xl);
		letter-spacing: -0.024em;
		line-height: 1.14;
		color: hsl(var(--theme-text));
		margin: 0 0 18px;
		text-wrap: balance;
		word-wrap: break-word;
		overflow-wrap: break-word;
	}
	.post-title :global(em) {
		font-style: italic;
		color: hsl(var(--theme-accent));
		font-weight: 400;
	}

	.byline {
		font-family: var(--font-sans);
		font-size: var(--text-small);
		color: hsl(var(--theme-text-muted));
		margin: 0 0 14px;
		line-height: 1.5;
		font-variant-numeric: tabular-nums;
		font-feature-settings: "tnum";
	}
	.byline .sep {
		color: var(--faint);
		margin: 0 6px;
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		column-gap: 14px;
		font-family: var(--font-sans);
		font-size: var(--text-meta);
		color: hsl(var(--theme-text-muted));
		margin-bottom: 32px;
		word-break: break-word;
	}
	.post-tags .tag-link {
		padding: 4px 0;
		margin: -4px 0;
		color: inherit;
		text-decoration: none;
		transition: color 0.2s ease;
	}
	.post-tags .tag-link::before {
		content: "#";
		color: var(--faint);
		transition: color 0.2s ease;
	}
	.post-tags .tag-link:hover,
	.post-tags .tag-link:hover::before {
		color: hsl(var(--theme-accent));
	}
	.post-tags .tag-link:focus-visible {
		outline: 2px solid hsl(var(--theme-accent));
		outline-offset: 2px;
		border-radius: 3px;
	}

	.post-updated {
		font-family: var(--font-sans);
		font-size: var(--text-meta);
		color: hsl(var(--theme-text-muted));
		margin: -16px 0 32px;
	}

	.rule {
		height: 1px;
		background: var(--hairline);
		border: 0;
		margin: 0 0 44px;
		transition: background-color 0.35s ease;
	}
	/* Extra spacing so stacked footer blocks (post-end link, comments) read as intentional. */
	.rule--footer {
		margin: 56px 0 28px;
	}

	/* Match article body width */
	.comments { max-width: var(--reading-width); margin: 56px 0 32px; }
	.comments .giscus { max-width: 100%; }

	/* Prev/Next post navigation */
	.post-pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		column-gap: 32px;
		row-gap: 28px;
		margin: 0 0 56px;
		padding: 0 0 0 0;
	}
	.pager-link {
		display: block;
		text-decoration: none;
		min-width: 0;
		transition: transform 0.25s ease;
	}
	.pager-link.next {
		text-align: right;
	}
	.pager-link.prev:hover { transform: translateX(-2px); }
	.pager-link.next:hover { transform: translateX(2px); }
	.pager-eyebrow {
		display: block;
		font-family: var(--font-sans);
		font-size: var(--text-meta);
		font-weight: 500;
		color: hsl(var(--theme-text-muted));
		margin-bottom: 8px;
	}
	.pager-link.prev .pager-eyebrow::before { content: "← "; }
	.pager-link.next .pager-eyebrow::after { content: " →"; }
	.pager-title {
		display: block;
		font-family: var(--font-sans);
		font-size: var(--title-s);
		line-height: 1.35;
		font-weight: var(--title-weight);
		letter-spacing: -0.011em;
		color: hsl(var(--theme-text));
		text-wrap: balance;
		word-wrap: break-word;
		overflow-wrap: anywhere;
		transition: color 0.2s ease;
	}
	.pager-link:hover .pager-title {
		color: hsl(var(--theme-accent));
	}
	/* Lone prev/next spans full width, text on its natural side. */
	.post-pager:has(.pager-link.prev:only-child) .pager-link.prev,
	.post-pager:has(.pager-link.next:only-child) .pager-link.next {
		grid-column: 1 / -1;
	}
	@media (max-width: 720px) {
		.post-pager {
			grid-template-columns: 1fr;
			row-gap: 22px;
			margin-bottom: 40px;
		}
		.pager-link.next {
			order: 0;
			text-align: left;
		}
		.pager-link.prev {
			order: 1;
		}
	}

	@media (max-width: 720px) {
		.post-title { line-height: 1.15; }
		.rule { margin-bottom: 32px; }
	}
	@media (max-width: 420px) {
		.crumbs { margin-bottom: 18px; }
		.byline { margin-bottom: 24px; }
		.rule { margin-bottom: 26px; }
	}
</style>

<style is:global>
	.post-article {
		font-family: var(--font-sans);
		color: hsl(var(--theme-text));
	}

	.post-article > p {
		font-size: var(--text-body);
		line-height: 1.7;
		color: hsl(var(--theme-text));
		margin: 0 0 24px;
		max-width: var(--reading-width);
		word-wrap: break-word;
		overflow-wrap: anywhere;
	}
	.post-article p em,
	.post-article em {
		font-style: italic;
	}
	.post-article p strong,
	.post-article strong {
		font-weight: 600;
		color: hsl(var(--theme-text));
	}

	.post-article h1 {
		font-family: var(--font-sans);
		font-weight: var(--title-weight-large);
		font-size: var(--title-l);
		line-height: 1.25;
		letter-spacing: -0.019em;
		color: hsl(var(--theme-text));
		margin: 60px 0 22px;
		word-wrap: break-word;
		overflow-wrap: anywhere;
	}
	.post-article h2 {
		font-family: var(--font-sans);
		font-weight: var(--title-weight-large);
		font-size: var(--title-l);
		line-height: 1.25;
		letter-spacing: -0.019em;
		color: hsl(var(--theme-text));
		margin: 56px 0 20px;
		word-wrap: break-word;
		overflow-wrap: anywhere;
	}
	.post-article h3 {
		font-family: var(--font-sans);
		font-weight: var(--title-weight);
		font-size: var(--title-m);
		line-height: 1.35;
		letter-spacing: -0.011em;
		color: hsl(var(--theme-text));
		margin: 38px 0 14px;
		word-wrap: break-word;
		overflow-wrap: anywhere;
	}
	.post-article h4 {
		font-family: var(--font-sans);
		font-weight: var(--title-weight);
		font-size: var(--title-s);
		line-height: 1.35;
		color: hsl(var(--theme-text));
		margin: 30px 0 12px;
	}
	.post-article h5 {
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: var(--text-body);
		line-height: 1.4;
		color: hsl(var(--theme-text));
		margin: 26px 0 10px;
	}
	.post-article h6 {
		font-family: var(--font-sans);
		font-weight: 500;
		font-size: var(--text-meta);
		line-height: 1.5;
		color: hsl(var(--theme-text-muted));
		margin: 24px 0 10px;
	}

	.post-article a {
		color: hsl(var(--theme-text));
		text-decoration: underline;
		text-decoration-color: hsl(var(--theme-text) / 0.35);
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		word-break: break-word;
		overflow-wrap: anywhere;
		transition: color 0.2s ease, text-decoration-color 0.2s ease;
	}
	.post-article a:hover {
		color: hsl(var(--theme-accent));
		text-decoration-color: hsl(var(--theme-accent));
	}

	.post-article :not(pre) > code {
		font-family: var(--font-mono);
		font-size: 0.875em;
		background: var(--paper);
		border: 1px solid var(--hairline);
		padding: 1px 6px;
		border-radius: 3px;
		color: hsl(var(--theme-text));
		font-variant-numeric: tabular-nums;
		font-feature-settings: "tnum";
		transition: background-color 0.35s ease, border-color 0.35s ease;
	}

	.post-article pre {
		background: var(--paper);
		border: 1px solid var(--hairline);
		border-radius: 4px;
		padding: 16px;
		margin: 28px 0;
		overflow-x: auto;
		max-width: 100%;
		font-size: 0.875rem;
		line-height: 1.7;
		transition: background-color 0.35s ease, border-color 0.35s ease;
	}
	.post-article pre code {
		background: transparent;
		border: 0;
		padding: 0;
		font-size: inherit;
		color: inherit;
	}
	/* expressive-code wrapper safety */
	.post-article .expressive-code {
		margin: 28px 0;
	}
	.post-article > div:has(> .expressive-code) {
		margin: 28px 0;
		overflow: auto !important;
		scrollbar-width: thin;
		scrollbar-color: var(--faint) transparent;
	}
	.post-article > div > .expressive-code {
		margin: 0;
	}
	.post-article .expressive-code pre[data-language]::after {
		content: attr(data-language);
		position: absolute;
		top: 12px;
		right: 14px;
		z-index: 1;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		line-height: 1;
		color: hsl(var(--theme-text-muted));
		pointer-events: none;
		user-select: none;
		transition: opacity 0.2s ease;
	}
	@media (hover: hover) {
		.post-article .expressive-code .frame:not(.has-title, .is-terminal):hover pre[data-language]::after,
		.post-article .expressive-code .frame:not(.has-title, .is-terminal):focus-within pre[data-language]::after {
			opacity: 0;
		}
	}
	@media (hover: none) {
		.post-article .expressive-code .frame:not(.has-title, .is-terminal) pre[data-language]::after {
			right: 56px;
		}
	}
	.post-article .expressive-code pre[data-language="plaintext"]::after,
	.post-article .expressive-code pre[data-language="text"]::after,
	.post-article .expressive-code pre[data-language="txt"]::after {
		content: none;
	}
	.post-article .expressive-code pre[data-clipped]::before {
		content: "";
		position: absolute;
		top: var(--clip-top, 0px);
		right: var(--ec-brdWd);
		bottom: var(--ec-brdWd);
		z-index: 1;
		width: 40px;
		border-radius: 0 var(--ec-brdRad) var(--ec-brdRad) 0;
		background: linear-gradient(to right, transparent, var(--code-background));
		pointer-events: none;
	}

	.post-article ul {
		margin: 0 0 28px;
		padding: 0;
		list-style: none;
		max-width: var(--reading-width);
	}
	.post-article ul li {
		position: relative;
		padding-left: 22px;
		font-size: var(--text-body);
		line-height: 1.7;
		color: hsl(var(--theme-text));
		margin-bottom: 10px;
		word-wrap: break-word;
		overflow-wrap: anywhere;
	}
	.post-article ul li::before {
		content: "";
		position: absolute;
		left: 4px;
		top: 0.78em;
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: var(--faint);
	}
	.post-article ul ul {
		margin: 10px 0 4px;
	}
	.post-article ul ul li {
		margin-bottom: 6px;
	}
	.post-article ul ul li::before {
		background: transparent;
		border: 1px solid var(--faint);
		width: 5px;
		height: 5px;
	}

	.post-article ol {
		margin: 0 0 28px;
		padding-left: 22px;
		max-width: var(--reading-width);
	}
	.post-article ol li {
		font-size: var(--text-body);
		line-height: 1.7;
		color: hsl(var(--theme-text));
		margin-bottom: 10px;
		padding-left: 6px;
	}
	.post-article ol li::marker {
		color: hsl(var(--theme-text-muted));
	}
	.post-article ol {
    	list-style: decimal;
	}

	.post-article li > p {
		margin: 0;
		display: inline;
	}

	.post-article blockquote {
		margin: 28px 0;
		padding: 4px 0 4px 22px;
		border-left: 2px solid var(--faint);
		color: hsl(var(--theme-text-muted));
		font-size: var(--text-body);
		line-height: 1.65;
		max-width: var(--reading-width);
	}
	.post-article blockquote p {
		margin: 0 0 12px;
		font-size: inherit;
		max-width: none;
	}
	.post-article blockquote p:last-child {
		margin-bottom: 0;
	}

	/* Predictable sizing prevents CLS */
	.post-article figure {
		margin: 36px 0;
		padding: 0;
	}
	.post-article figure video,
	.post-article video {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid var(--hairline);
		background: var(--paper);
		transition: border-color 0.35s ease;
	}
	.post-article img {
		display: block;
		max-width: 100%;
		height: auto;
		border: 1px solid var(--hairline);
		background: var(--paper);
	}
	@media (prefers-reduced-motion: no-preference) and (scripting: enabled) {
		.post-article img[loading="lazy"]:not([data-in]) {
			opacity: 0;
		}
		.post-article img[loading="lazy"][data-in] {
			opacity: 1;
			transition: opacity 360ms ease;
		}
	}

	.post-article h1,
	.post-article h2,
	.post-article h3,
	.post-article h4,
	.post-article h5,
	.post-article h6 {
		position: relative;
		scroll-margin-top: 2rem;
	}
	.post-article .heading-anchor {
		position: absolute;
		left: -1.25em;
		top: 0;
		bottom: 0;
		display: inline-flex;
		align-items: center;
		font-family: var(--font-mono);
		font-size: 0.7em;
		color: hsl(var(--theme-accent));
		opacity: 0.4;
		transition: opacity 0.18s ease;
		text-decoration: none;
		padding: 0 0.4em 0.15em;
		background: transparent;
		border: 0;
		cursor: pointer;
	}
	.post-article .heading-anchor::before {
		content: "";
		position: absolute;
		top: 50%;
		left: 50%;
		width: max(100%, 28px);
		height: max(100%, 28px);
		transform: translate(-50%, -50%);
	}
	@media (hover: hover) {
