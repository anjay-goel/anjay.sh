---
import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import SkipLink from "@/components/SkipLink.astro";
import SearchDialog from "@/components/search/SearchDialog.astro";
import ShortcutsDialog from "@/components/shortcuts/ShortcutsDialog.astro";
import ThemeProvider from "@/components/ThemeProvider.astro";
import Container from "@/components/ui/Container.astro";
import { siteConfig } from "@/site-config";
import type { SiteMeta } from "@/types";

interface Props {
	meta: SiteMeta;
	width?: "default" | "article";
	footer?: "standard" | "home" | "none";
	navCurrent?: string | null;
	headerDense?: boolean;
}

const {
	meta: { articleDate, articleModified, description = siteConfig.description, noindex, ogImage, title },
	width = "default",
	footer = "standard",
	navCurrent,
	headerDense = false,
} = Astro.props;
---

<html lang={siteConfig.lang}>
	<head>
		<BaseHead
			articleDate={articleDate}
			articleModified={articleModified}
			description={description}
			noindex={noindex}
			ogImage={ogImage}
			title={title}
		/>
		<ThemeProvider />
		<slot name="head" />
	</head>
	<body>
		<SkipLink />
		<slot name="before" />
		<Container class="page" width={width}>
			<Header current={navCurrent} dense={headerDense} />
			<main id="main" class="page-main" tabindex="-1">
				<slot />
			</main>
			{footer !== "none" && <Footer variant={footer} />}
		</Container>
		<slot name="after" />
		<SearchDialog />
		<ShortcutsDialog />
		<script>
			import "@/scripts/site";
		</script>
	</body>
</html>

<style>
	.page {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		min-height: 100dvh;
	}
	.page-main {
		flex: 1 0 auto;
		min-width: 0;
	}
	.page-main:focus-visible {
		outline: none;
	}
</style>
